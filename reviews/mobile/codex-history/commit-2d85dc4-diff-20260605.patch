+export function findSection(key: string): Section | null {
+  return RESUME_SECTIONS.find((s) => s.key === key) || EXTRA_SECTIONS.find((s) => s.key === key) || null;
+}
+
+/** Builds an empty entry/record: '' for text/date/dropdown, false for checkbox. */
+export function buildEmptyEntry(section: Section): Record<string, unknown> {
+  const entry: Record<string, unknown> = {};
+  for (const field of section.fields ?? []) {
+    entry[field.key] = field.type === 'checkbox' ? false : '';
+  }
+  return entry;
+}
+
+/**
+ * Each predefined category holds an array of skill name strings; `custom` is
+ * an array of `{ name, skills: [] }`. Storing individual skills (rather than
+ * one comma string) lets each skill be removed on its own with a swipe.
+ */
+export function buildEmptySkills(): ResumeSkillsState {
+  const skills: ResumeSkillsState = { custom: [] };
+  for (const category of SKILL_CATEGORIES) {
+    skills[category.key] = [];
+  }
+  return skills;
+}
+
+/**
+ * Initial local state for the whole builder. Personal + Summary share the
+ * `personal` record; list sections start empty; skills gets its category map.
+ * Extra-section data is created lazily when the section is added.
+ */
+export function buildInitialResumeValues(): ResumeBuilderValues {
+  return {
+    personal: {
+      fullName: '',
+      email: '',
+      phone: '',
+      location: '',
+      linkedin: '',
+      github: '',
+      portfolio: '',
+      headline: '',
+      summary: '',
+    },
+    education: [],
+    experience: [],
+    internships: [],
+    projects: [],
+    certifications: [],
+    skills: buildEmptySkills(),
+  };
+}
+
+/**
+ * Returns a `{ fieldKey: message }` map of validation errors. Enforces
+ * required fields, a sane phone length, and start/end ordering.
+ */
+export function validateFields(
+  fields: SectionField[] | undefined,
+  data: Record<string, unknown> | undefined,
+): Record<string, string> {
+  const errors: Record<string, string> = {};
+
+  for (const field of fields ?? []) {
+    const raw = data?.[field.key];
+    const value = typeof raw === 'string' ? raw.trim() : raw;
+
+    if (field.required && (value === '' || value === undefined || value === null || value === false)) {
+      errors[field.key] = `${field.label} is required`;
+      continue;
+    }
+
+    if (field.type === 'phone' && field.required) {
+      const digits = String(raw ?? '').replace(/\D/g, '');
+      if (digits.length < 8) {
+        errors[field.key] = 'Enter a valid phone number with country code';
+      }
+    }
+  }
+
+  const start = String(data?.start_date ?? '').trim();
+  const end = String(data?.end_date ?? '').trim();
+  if (start && end && !data?.currentlyWorking && end < start) {
+    errors.end_date = 'End date must be on or after the start date';
+  }
+
+  return errors;
+}
+
+/**
+ * True when a section has at least one meaningful value — drives the builder
+ * progress ring and the per-card "completed" tick.
+ */
+export function isSectionComplete(
+  section: Section | null | undefined,
+  values: Partial<ResumeBuilderValues> | undefined,
+): boolean {
+  if (!section) return false;
+
+  if (section.kind === 'skills') {
+    const skills = (values?.skills ?? {}) as ResumeSkillsState;
+    const hasCategory = SKILL_CATEGORIES.some((c) => ((skills[c.key] as string[]) ?? []).length > 0);
+    const hasCustom = Array.isArray(skills.custom) ? skills.custom.some((c) => (c?.skills ?? []).length > 0) : false;
+    return hasCategory || hasCustom;
+  }
+
+  if (section.kind === 'list') {
+    const list = (values as Record<string, unknown>)?.[section.dataKey];
+    return Array.isArray(list) && list.length > 0;
+  }
+
+  // record
+  const record = ((values as Record<string, unknown>)?.[section.dataKey] ?? {}) as Record<string, unknown>;
+  return (section.fields ?? []).some((f) => {
+    const v = record[f.key];
+    return typeof v === 'string' ? v.trim() !== '' : Boolean(v);
+  });
+}
