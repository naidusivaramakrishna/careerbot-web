@@ -0,0 +1,599 @@
+// Resume Builder — section + field definitions.
+//
+// Each section drives one form behind a card on the builder list. Field `key`s
+// deliberately mirror the backend profile wire schema (institution, degree,
+// job_title, company, project_name, certification_name, …) so the real
+// save/load endpoints can consume this state with little to no translation.
+//
+// Section `kind`:
+//   - 'record'  one object (Personal Info, Professional Summary). Personal and
+//               Summary intentionally share `dataKey: 'personal'` so they edit
+//               the same underlying record (full name + summary in one place).
+//   - 'list'    an array of entries (Education, Work, Projects, …). `summary`
+//               builds the saved-card text; `addLabel` is the add button text.
+//   - 'skills'  the custom categorised skills editor.
+//
+// `required: true` on a field renders a red asterisk and is enforced on Save.
+// `ai: true` on a section/field shows the (coming-soon) AI Writer button.
+//
+// TS port of POC src/screens/resumeBuilder/resumeBuilderConfig.js.
+
+// ── Types ───────────────────────────────────────────────────────────────────
+
+export type SectionKind = 'record' | 'list' | 'skills';
+
+export interface FieldOption {
+  label: string;
+  value: string;
+}
+
+export interface SectionField {
+  key: string;
+  label: string;
+  placeholder?: string;
+  width?: 'full' | 'half';
+  required?: boolean;
+  multiline?: boolean;
+  ai?: boolean;
+  type?: 'date' | 'phone' | 'checkbox' | 'dropdown';
+  keyboardType?: 'email-address' | 'decimal-pad' | 'phone-pad' | 'default' | 'numeric';
+  options?: FieldOption[];
+  hideWhenCurrent?: boolean;
+  optionalLabel?: string;
+}
+
+export interface SectionSummaryView {
+  title: string;
+  subtitle?: string;
+  meta: string[];
+}
+
+export interface Section {
+  key: string;
+  title: string;
+  icon: string;
+  kind: SectionKind;
+  dataKey: string;
+  ai?: boolean;
+  addLabel?: string;
+  addAnother?: boolean;
+  fields?: SectionField[];
+  tips?: string[];
+  tipsNote?: string;
+  summary?: (entry: Record<string, unknown>) => SectionSummaryView;
+}
+
+export interface SkillCategory {
+  key: string;
+  label: string;
+  placeholder: string;
+}
+
+export interface CustomSkillGroup {
+  name: string;
+  skills: string[];
+}
+
+export interface ResumeSkillsState {
+  custom: CustomSkillGroup[];
+  // Predefined SKILL_CATEGORIES keys map to string arrays of skill names.
+  [category: string]: string[] | CustomSkillGroup[];
+}
+
+export interface PersonalInfoState {
+  fullName: string;
+  email: string;
+  phone: string;
+  location: string;
+  linkedin: string;
+  github: string;
+  portfolio: string;
+  headline: string;
+  summary: string;
+}
+
+export interface EducationEntry {
+  institution: string;
+  degree: string;
+  start_date: string;
+  end_date: string;
+  score_type: string;
+  cgpa: string;
+}
+
+export interface ExperienceEntry {
+  company: string;
+  job_title: string;
+  location: string;
+  start_date: string;
+  end_date: string;
+  currentlyWorking: boolean;
+  description: string;
+}
+
+export interface ProjectEntry {
+  project_name: string;
+  technologies: string;
+  start_date: string;
+  end_date: string;
+  project_link: string;
+  description: string;
+}
+
+export interface CertificationEntry {
+  certification_name: string;
+  issuer: string;
+  start_date: string;
+  end_date: string;
+  credential_id: string;
+}
+
+export interface ResumeBuilderValues {
+  personal: PersonalInfoState;
+  education: EducationEntry[];
+  experience: ExperienceEntry[];
+  internships: ExperienceEntry[];
+  projects: ProjectEntry[];
+  certifications: CertificationEntry[];
+  skills: ResumeSkillsState;
+  languages?: Record<string, unknown>[];
+  awards?: Record<string, unknown>[];
+  achievements?: Record<string, unknown>[];
+  references?: Record<string, unknown>[];
+  volunteering?: Record<string, unknown>[];
+  hobbies?: { items: string };
+  [extra: string]: unknown;
+}
+
+// ── Constants ───────────────────────────────────────────────────────────────
+
+export const SKILL_CATEGORIES: SkillCategory[] = [
+  { key: 'programming', label: 'Programming Languages', placeholder: 'e.g., Python, JavaScript, Java...' },
+  { key: 'frameworks', label: 'Frameworks & Libraries', placeholder: 'e.g., React, Django, FastAPI...' },
+  { key: 'databases', label: 'Databases', placeholder: 'e.g., PostgreSQL, MongoDB...' },
+  { key: 'tools', label: 'Tools & Technologies', placeholder: 'e.g., Docker, Git, Jenkins...' },
+  { key: 'cloud', label: 'Cloud Platforms', placeholder: 'e.g., AWS, Azure, Google Cloud...' },
+  { key: 'soft', label: 'Soft Skills', placeholder: 'e.g., Leadership, Communication...' },
+];
+
+const SCORE_TYPE_OPTIONS: FieldOption[] = [
+  { label: 'GPA', value: 'gpa' },
+  { label: 'CGPA', value: 'cgpa' },
+  { label: 'Percentage', value: 'percentage' },
+];
+
+const PROFICIENCY_OPTIONS: FieldOption[] = [
+  { label: 'Native', value: 'native' },
+  { label: 'Fluent', value: 'fluent' },
+  { label: 'Professional', value: 'professional' },
+  { label: 'Intermediate', value: 'intermediate' },
+  { label: 'Basic', value: 'basic' },
+];
+
+// ── Primary sections (in screenshot order) ──────────────────────────────────
+
+export const RESUME_SECTIONS: Section[] = [
+  {
+    key: 'personal',
+    title: 'Personal Info',
+    icon: 'person-circle-outline',
+    kind: 'record',
+    dataKey: 'personal',
+    tips: [
+      'Always include your full name, professional email address, current phone number, and city-state location to help recruiters contact you for interviews easily.',
+      'Add LinkedIn profile and portfolio links only when they are current, professional, relevant to your industry, and showcase your work effectively.',
+    ],
