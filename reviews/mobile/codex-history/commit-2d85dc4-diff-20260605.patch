+// ResumeRenderer — the single, config-driven renderer for every resume
+// template. There are NO per-template screens: a template is a JSON
+// configuration (colors, typography, layout, section order, margins, styling
+// rules) returned by GET /api/v1/templates/{template_id}, and this component
+// applies it to the resume data.
+//
+//   <ResumeRenderer resumeData={resumeData} templateConfig={templateConfig} />
+//
+//   resumeData      — the Resume Builder state shape (see resumeBuilderConfig):
+//                     { personal, education, experience, projects, skills,
+//                       certifications, languages, awards, ... }
+//   templateConfig  — the backend template configuration JSON. All fields are
+//                     optional; sensible defaults fill any gaps so a partial or
+//                     missing config still renders.
+//
+// The same renderer is intended to back future PDF export / download / share
+// and live template switching — keep it pure (props in, view out) so it can be
+// snapshotted or rasterised without side effects.
+//
+// TS port of POC src/components/resume/ResumeRenderer.js.
+
+import { memo, useMemo, type ReactNode } from 'react';
+import { StyleSheet, Text, View, type StyleProp, type TextStyle } from 'react-native';
+
+import type { ResumeBuilderValues, ResumeSkillsState } from '@/features/resumes/resumeBuilderConfig';
+
+// ── Fallback config (used when fields are missing in backend config) ────────
+
+const FALLBACK = {
+  colors: {
+    primary: '#2557A7',
+    accent: '#2557A7',
+    heading: '#152033',
+    sectionHeading: '#152033',
+    text: '#1f2a3d',
+    muted: '#637083',
+    background: '#ffffff',
+    divider: '#e1e6ee',
+  },
+  typography: {
+    fontFamily: undefined as string | undefined,
+    nameSize: 20,
+    sectionHeadingSize: 13,
+    subheadingSize: 12.5,
+    bodySize: 11,
+    lineHeight: 1.45,
+    uppercaseHeadings: true,
+    letterSpacing: 0.5,
+    nameTransform: null as TextStyle['textTransform'] | null,
+  },
+  layout: {
+    alignment: 'left' as 'left' | 'center',
+    margin: 26,
+    sectionGap: 16,
+    showDividers: true,
+    sectionHeadingAlignment: null as TextStyle['textAlign'] | null,
+    sectionLabels: {} as Record<string, string>,
+    sectionOrder: [
+      'summary',
+      'experience',
+      'education',
+      'projects',
+      'skills',
+      'certifications',
+      'languages',
+      'awards',
+      'achievements',
+      'volunteering',
+      'references',
+      'hobbies',
+    ],
+  },
+};
+
+// Normalises backend section key names (snake_case, camelCase, plural) to the
+// internal keys used by sectionRenderers.
+const SECTION_KEY_ALIASES: Record<string, string> = {
+  professional_summary: 'summary',
+  professionalSummary: 'summary',
+  summary: 'summary',
+  // Objective (fresher templates) renders into the same summary slot
+  objective: 'summary',
+  // Executive summary (senior/manager templates) also renders as summary
+  executive_summary: 'summary',
+  executiveSummary: 'summary',
+  work_experience: 'experience',
+  workExperience: 'experience',
+  work: 'experience',
+  experience: 'experience',
+  internship: 'internships',
+  internships: 'internships',
+  education: 'education',
+  project: 'projects',
+  projects: 'projects',
+  skill: 'skills',
+  skills: 'skills',
+  // Core competencies and technical skills share the skills slot
+  core_competencies: 'skills',
+  coreCompetencies: 'skills',
+  technical_skills: 'skills',
+  technicalSkills: 'skills',
+  certification: 'certifications',
+  certifications: 'certifications',
+  language: 'languages',
+  languages: 'languages',
+  award: 'awards',
+  awards: 'awards',
+  achievement: 'achievements',
+  achievements: 'achievements',
+  volunteering: 'volunteering',
+  reference: 'references',
+  references: 'references',
+  hobby: 'hobbies',
+  hobbies: 'hobbies',
+  interest: 'hobbies',
+  interests: 'hobbies',
+};
+
+function normalizeSectionKey(key: string): string {
+  return SECTION_KEY_ALIASES[key] || key;
+}
+
+const SECTION_TITLES: Record<string, string> = {
+  summary: 'Professional Summary',
+  experience: 'Experience',
+  internships: 'Internships',
+  education: 'Education',
+  projects: 'Projects',
+  skills: 'Skills',
+  certifications: 'Certifications',
+  languages: 'Languages',
+  awards: 'Awards',
+  achievements: 'Achievements',
+  volunteering: 'Volunteering',
+  references: 'References',
+  hobbies: 'Interests & Hobbies',
+};
+
+const SKILL_LABELS: Record<string, string> = {
+  programming: 'Programming Languages',
+  frameworks: 'Frameworks & Libraries',
+  databases: 'Databases',
+  tools: 'Tools & Technologies',
+  cloud: 'Cloud Platforms',
+  soft: 'Soft Skills',
+};
+
+// ── resolveConfig ───────────────────────────────────────────────────────────
+
+interface ResolvedConfig {
+  colors: typeof FALLBACK.colors;
+  typography: typeof FALLBACK.typography;
+  layout: {
+    alignment: 'left' | 'center';
+    margin: number;
+    sectionGap: number;
+    showDividers: boolean;
+    sectionOrder: string[];
+    sectionLabels: Record<string, string>;
+    sectionHeadingAlignment: TextStyle['textAlign'] | null;
+  };
+}
+
+interface RawConfig {
+  colors?: Record<string, unknown>;
+  typography?: Record<string, unknown>;
+  fonts?: Record<string, unknown>;
+  layout?: Record<string, unknown>;
+  styling?: Record<string, unknown>;
+  sections?: Record<string, { order?: number; enabled?: boolean; label?: string }>;
+  sectionOrder?: string[];
+  section_order?: string[];
+  primaryColor?: string;
+  alignment?: string;
+  margins?: number | { top?: number; right?: number; bottom?: number; left?: number };
+  [extra: string]: unknown;
+}
+
+/**
+ * Merge backend config over the fallback. Handles snake_case + camelCase typo
+ * keys, styling.* shortcuts, layout.margins as scalar/object, and the sections
+ * map → sectionOrder + sectionLabels conversion.
+ */
+function resolveConfig(config: RawConfig = {}): ResolvedConfig {
+  const c = config || {};
+  const rawColors = (c.colors ?? {}) as Record<string, string | undefined>;
+  const rawTypo = (c.typography ?? c.fonts ?? {}) as Record<string, unknown>;
+  const rawLayout = (c.layout ?? {}) as Record<string, unknown>;
+  const rawStyling = (c.styling ?? {}) as Record<string, unknown>;
+
+  // ── Colors ──────────────────────────────────────────────────────────────
+  const dividerColor =
+    (rawStyling.divider_color as string | undefined) ?? rawColors.divider ?? FALLBACK.colors.divider;
+  const sectionHeadingColor =
+    (rawStyling.section_heading_color as string | undefined) ??
+    rawColors.accent ??
+    rawColors.primary ??
+    FALLBACK.colors.sectionHeading;
+
+  const colors = {
+    ...FALLBACK.colors,
+    ...(rawColors.primary != null && { primary: rawColors.primary }),
+    ...(rawColors.accent != null && { accent: rawColors.accent }),
+    // secondary from the backend maps to body text color
+    ...(rawColors.secondary != null && { text: rawColors.secondary }),
+    ...(rawColors.heading != null && { heading: rawColors.heading }),
+    // explicit `text` overrides secondary if both are present
+    ...(rawColors.text != null && { text: rawColors.text }),
+    ...(rawColors.muted != null && { muted: rawColors.muted }),
+    ...(rawColors.background != null && { background: rawColors.background }),
+    ...(c.primaryColor != null && { primary: c.primaryColor }),
+    divider: dividerColor,
+    sectionHeading: sectionHeadingColor,
+  };
+
+  // ── Typography (accepts snake_case OR camelCase) ─────────────────────────
+  const nameSize =
+    (rawStyling.name_size as number | undefined) ??
+    (rawTypo.nameSize as number | undefined) ??
+    (rawTypo.name_size as number | undefined) ??
+    (rawTypo.headingSize as number | undefined) ??
+    (rawTypo.heading_size as number | undefined) ??
+    FALLBACK.typography.nameSize;
+
+  const sectionHeadingSize =
+    (rawTypo.sectionHeadingSize as number | undefined) ??
+    (rawTypo.section_heading_size as number | undefined) ??
+    FALLBACK.typography.sectionHeadingSize;
+
+  const typography = {
+    fontFamily:
+      (rawTypo.fontFamily as string | undefined) ?? (rawTypo.font_family as string | undefined) ?? FALLBACK.typography.fontFamily,
+    nameSize,
+    sectionHeadingSize,
+    subheadingSize:
+      (rawTypo.subheadingSize as number | undefined) ??
+      (rawTypo.subheading_size as number | undefined) ??
+      FALLBACK.typography.subheadingSize,
+    bodySize: (rawTypo.bodySize as number | undefined) ?? (rawTypo.body_size as number | undefined) ?? FALLBACK.typography.bodySize,
+    lineHeight:
+      (rawTypo.lineHeight as number | undefined) ?? (rawTypo.line_height as number | undefined) ?? FALLBACK.typography.lineHeight,
+    uppercaseHeadings:
+      (rawTypo.uppercaseHeadings as boolean | undefined) ??
+      (rawTypo.uppercase_headings as boolean | undefined) ??
+      FALLBACK.typography.uppercaseHeadings,
+    letterSpacing:
+      (rawTypo.letterSpacing as number | undefined) ??
+      (rawTypo.letter_spacing as number | undefined) ??
+      FALLBACK.typography.letterSpacing,
+    nameTransform:
+      (rawStyling.name_transform as TextStyle['textTransform'] | undefined) ??
+      (rawTypo.nameTransform as TextStyle['textTransform'] | undefined) ??
+      (rawTypo.name_transform as TextStyle['textTransform'] | undefined) ??
+      null,
+  };
+
+  // ── Section order + labels ───────────────────────────────────────────────
+  let sectionOrder: string[] | null = null;
+  const sectionLabels: Record<string, string> = {};
+
+  const rawOrder =
+    c.sectionOrder ?? c.section_order ?? (rawLayout.sectionOrder as string[] | undefined) ?? (rawLayout.section_order as string[] | undefined);
+
+  if (Array.isArray(rawOrder) && rawOrder.length) {
+    sectionOrder = rawOrder.map(normalizeSectionKey);
+  } else if (c.sections && typeof c.sections === 'object' && !Array.isArray(c.sections)) {
+    sectionOrder = Object.entries(c.sections)
+      .filter(([, v]) => v?.enabled !== false)
+      .sort(([, a], [, b]) => (a?.order ?? 999) - (b?.order ?? 999))
+      .map(([key]) => normalizeSectionKey(key));
+    if (!sectionOrder.length) sectionOrder = null;
+
+    // Extract per-section labels so the renderer can show the template's
+    // intended heading (e.g. "OBJECTIVE" vs "PROFESSIONAL SUMMARY").
+    for (const [key, def] of Object.entries(c.sections)) {
+      if (def?.label) {
+        const normalizedKey = normalizeSectionKey(key);
+        sectionLabels[normalizedKey] = def.label;
+      }
+    }
+  }
+
+  if (!sectionOrder) sectionOrder = FALLBACK.layout.sectionOrder;
+
+  // Deduplicate (e.g. two keys that both map to 'skills').
+  const seen = new Set<string>();
+  sectionOrder = sectionOrder.filter((k) => {
+    if (seen.has(k)) return false;
+    seen.add(k);
+    return true;
+  });
+
+  // ── Layout margin — number or { top, right, bottom, left } ───────────────
+  let margin: number = FALLBACK.layout.margin;
+  const rawMargins = (rawLayout.margins ?? rawLayout.margin ?? c.margins) as
+    | number
+    | { top?: number; right?: number; bottom?: number; left?: number }
+    | undefined;
+  if (typeof rawMargins === 'number') {
+    margin = rawMargins;
+  } else if (rawMargins && typeof rawMargins === 'object') {
+    margin = rawMargins.left ?? rawMargins.right ?? rawMargins.top ?? FALLBACK.layout.margin;
+  }
+
+  // ── Remaining layout fields ──────────────────────────────────────────────
+  const alignmentRaw =
+    (rawStyling.name_alignment as string | undefined) ??
+    (rawStyling.alignment as string | undefined) ??
+    (rawLayout.alignment as string | undefined) ??
+    c.alignment ??
+    FALLBACK.layout.alignment;
+  const alignment: 'left' | 'center' = alignmentRaw === 'center' ? 'center' : 'left';
+
+  const showDividers =
+    (rawStyling.section_dividers as boolean | undefined) ??
+    (rawLayout.showDividers as boolean | undefined) ??
+    (rawLayout.show_dividers as boolean | undefined) ??
+    FALLBACK.layout.showDividers;
+
+  const sectionGap =
+    (rawStyling.section_spacing as number | undefined) ??
+    (rawLayout.sectionGap as number | undefined) ??
+    (rawLayout.section_gap as number | undefined) ??
+    FALLBACK.layout.sectionGap;
+
+  const sectionHeadingAlignment =
+    (rawStyling.section_heading_alignment as TextStyle['textAlign'] | undefined) ??
+    (rawLayout.sectionHeadingAlignment as TextStyle['textAlign'] | undefined) ??
+    null;
+
+  return {
+    colors,
+    typography,
+    layout: {
+      alignment,
+      margin,
+      sectionGap,
+      showDividers,
+      sectionOrder,
+      sectionLabels,
+      sectionHeadingAlignment,
+    },
+  };
+}
+
+// ── Small helpers ───────────────────────────────────────────────────────────
+
+function str(value: unknown): string {
+  return typeof value === 'string' ? value.trim() : value ? String(value) : '';
+}
+
+function dateRange(start: unknown, end: unknown, current?: unknown): string {
+  const left = str(start);
+  const right = current ? 'Present' : str(end);
+  return [left, right].filter(Boolean).join(' — ');
+}
+
+function hasContent(value: unknown): boolean {
+  if (Array.isArray(value)) return value.length > 0;
+  if (value && typeof value === 'object') return Object.keys(value).length > 0;
+  return Boolean(str(value));
+}
+
+// ── Component ───────────────────────────────────────────────────────────────
+
+export interface ResumeRendererProps {
+  resumeData?: Partial<ResumeBuilderValues>;
+  templateConfig?: RawConfig;
+}
+
+function ResumeRenderer({ resumeData = {}, templateConfig = {} }: ResumeRendererProps) {
+  // resolveConfig + StyleSheet.create are both pure functions of templateConfig.
+  // Memoising them on `templateConfig` means typing in the builder (which only
+  // changes `resumeData`) no longer rebuilds ~15 style objects and re-resolves
+  // the config on every keystroke — only a template change does.
+  const { colors, typography, layout } = useMemo(() => resolveConfig(templateConfig), [templateConfig]);
+
+  const personal = resumeData.personal ?? ({} as Partial<ResumeBuilderValues['personal']>);
+  const headingAlign: TextStyle['textAlign'] = layout.alignment === 'center' ? 'center' : 'left';
+
+  const dynamic = useMemo(
+    () =>
+      StyleSheet.create({
+        page: {
+          backgroundColor: colors.background,
+          padding: layout.margin,
+        },
+        name: {
+          color: colors.heading,
+          fontFamily: typography.fontFamily,
+          fontSize: typography.nameSize,
+          fontWeight: '800',
+          textAlign: headingAlign,
+          textTransform: typography.nameTransform ?? 'none',
+        },
+        headline: {
+          color: colors.primary,
+          fontFamily: typography.fontFamily,
+          fontSize: typography.subheadingSize,
+          fontWeight: '700',
+          marginTop: 2,
+          textAlign: headingAlign,
+        },
+        contact: {
+          color: colors.muted,
+          fontFamily: typography.fontFamily,
+          fontSize: typography.bodySize,
+          lineHeight: typography.bodySize * typography.lineHeight,
+          marginTop: 6,
+          textAlign: headingAlign,
+        },
+        sectionHeading: {
+          color: colors.sectionHeading,
+          fontFamily: typography.fontFamily,
+          fontSize: typography.sectionHeadingSize,
+          fontWeight: '800',
+          letterSpacing: typography.letterSpacing,
+          textTransform: typography.uppercaseHeadings ? 'uppercase' : 'none',
+          ...(layout.sectionHeadingAlignment && { textAlign: layout.sectionHeadingAlignment }),
+        },
+        divider: {
+          backgroundColor: colors.divider,
+          height: StyleSheet.hairlineWidth * 2,
+          marginTop: 4,
+        },
+        entryTitle: {
+          color: colors.heading,
+          fontFamily: typography.fontFamily,
+          fontSize: typography.subheadingSize,
+          fontWeight: '700',
+        },
+        entrySubtitle: {
+          color: colors.text,
+          fontFamily: typography.fontFamily,
+          fontSize: typography.bodySize,
+          fontWeight: '600',
+        },
+        entryMeta: {
+          color: colors.muted,
+          fontFamily: typography.fontFamily,
+          fontSize: typography.bodySize - 0.5,
+        },
+        body: {
+          color: colors.text,
+          fontFamily: typography.fontFamily,
+          fontSize: typography.bodySize,
+          lineHeight: typography.bodySize * typography.lineHeight,
+          marginTop: 3,
+        },
+        skillLabel: {
+          color: colors.heading,
+          fontFamily: typography.fontFamily,
+          fontSize: typography.bodySize,
+          fontWeight: '700',
+        },
+        skillValue: {
+          color: colors.text,
+          fontFamily: typography.fontFamily,
+          fontSize: typography.bodySize,
+        },
+      }),
+    [colors, typography, layout, headingAlign],
+  );
+
+  function Section({ sectionKey, children }: { sectionKey: string; children: ReactNode }) {
+    // Template-specific label wins over the generic title (e.g. "OBJECTIVE"
+    // for fresher templates, "PROFESSIONAL EXPERIENCE" for work experience).
+    const title = layout.sectionLabels?.[sectionKey] ?? SECTION_TITLES[sectionKey] ?? sectionKey;
+    return (
+      <View style={[staticStyles.section, { marginTop: layout.sectionGap }]}>
+        <Text style={dynamic.sectionHeading}>{title}</Text>
+        {layout.showDividers ? <View style={dynamic.divider} /> : null}
+        <View style={staticStyles.sectionBody}>{children}</View>
+      </View>
+    );
+  }
+
+  function renderHeader() {
+    const contactParts = [
+      str(personal.email),
+      str(personal.phone),
+      str(personal.location),
+      str(personal.linkedin),
+      str(personal.github),
+      str(personal.portfolio),
+    ].filter(Boolean);
+
+    return (
+      <View>
+        <Text style={dynamic.name}>{str(personal.fullName) || 'Your Name'}</Text>
+        {str(personal.headline) ? <Text style={dynamic.headline}>{str(personal.headline)}</Text> : null}
+        {contactParts.length ? <Text style={dynamic.contact}>{contactParts.join('  ·  ')}</Text> : null}
+      </View>
+    );
+  }
+
+  function renderSummary() {
+    const summary = str(personal.summary);
+    if (!summary) return null;
+    return (
+      <Section sectionKey="summary">
+        <Text style={dynamic.body}>{summary}</Text>
+      </Section>
+    );
+  }
+
+  function renderExperienceLike(sectionKey: string, list: unknown) {
+    if (!hasContent(list)) return null;
+    return (
+      <Section sectionKey={sectionKey}>
+        {(list as unknown as Record<string, unknown>[]).map((e, i) => (
+          <View key={i} style={(i > 0 ? staticStyles.entrySpacing : null) as StyleProp<TextStyle>}>
+            <View style={staticStyles.entryHeaderRow}>
+              <Text style={dynamic.entryTitle}>{str(e.job_title) || str(e.company)}</Text>
+              <Text style={dynamic.entryMeta}>{dateRange(e.start_date, e.end_date, e.currentlyWorking)}</Text>
+            </View>
+            <Text style={dynamic.entrySubtitle}>
+              {[str(e.company), str(e.location)].filter(Boolean).join('  ·  ')}
+            </Text>
+            {str(e.description) ? <Text style={dynamic.body}>{str(e.description)}</Text> : null}
+          </View>
+        ))}
+      </Section>
+    );
+  }
+
+  function renderEducation() {
+    const list = resumeData.education;
+    if (!hasContent(list)) return null;
+    return (
+      <Section sectionKey="education">
+        {(list as unknown as Record<string, unknown>[]).map((e, i) => (
+          <View key={i} style={(i > 0 ? staticStyles.entrySpacing : null) as StyleProp<TextStyle>}>
+            <View style={staticStyles.entryHeaderRow}>
+              <Text style={dynamic.entryTitle}>{str(e.institution) || 'Education'}</Text>
+              <Text style={dynamic.entryMeta}>{dateRange(e.start_date, e.end_date)}</Text>
+            </View>
+            <Text style={dynamic.entrySubtitle}>
+              {[
+                str(e.degree),
+                e.cgpa ? `${str(e.score_type).toUpperCase() || 'Score'}: ${str(e.cgpa)}` : '',
+              ]
+                .filter(Boolean)
+                .join('  ·  ')}
+            </Text>
+          </View>
+        ))}
+      </Section>
+    );
+  }
+
+  function renderProjects() {
+    const list = resumeData.projects;
+    if (!hasContent(list)) return null;
+    return (
+      <Section sectionKey="projects">
+        {(list as unknown as Record<string, unknown>[]).map((p, i) => (
+          <View key={i} style={(i > 0 ? staticStyles.entrySpacing : null) as StyleProp<TextStyle>}>
+            <View style={staticStyles.entryHeaderRow}>
+              <Text style={dynamic.entryTitle}>{str(p.project_name) || 'Project'}</Text>
+              <Text style={dynamic.entryMeta}>{dateRange(p.start_date, p.end_date)}</Text>
+            </View>
+            {str(p.technologies) ? <Text style={dynamic.entrySubtitle}>{str(p.technologies)}</Text> : null}
+            {str(p.description) ? <Text style={dynamic.body}>{str(p.description)}</Text> : null}
+            {str(p.project_link) ? <Text style={dynamic.entryMeta}>{str(p.project_link)}</Text> : null}
+          </View>
+        ))}
+      </Section>
+    );
+  }
+
+  function renderSkills() {
+    const skills = (resumeData.skills ?? {}) as ResumeSkillsState;
+    const groups: { label: string; value: string }[] = [];
+
+    for (const [key, label] of Object.entries(SKILL_LABELS)) {
+      const list = skills[key];
+      if (Array.isArray(list) && list.length) groups.push({ label, value: (list as string[]).join(', ') });
+    }
+    (skills.custom ?? []).forEach((cat) => {
+      if (cat?.name && (cat.skills ?? []).length) {
+        groups.push({ label: str(cat.name), value: cat.skills.join(', ') });
+      }
+    });
+
+    if (!groups.length) return null;
+    return (
+      <Section sectionKey="skills">
+        {groups.map((g, i) => (
+          <Text key={i} style={[dynamic.body, i > 0 ? staticStyles.skillSpacing : null]}>
+            <Text style={dynamic.skillLabel}>{g.label}: </Text>
+            <Text style={dynamic.skillValue}>{g.value}</Text>
+          </Text>
+        ))}
+      </Section>
+    );
+  }
+
+  function renderCertifications() {
+    const list = resumeData.certifications;
+    if (!hasContent(list)) return null;
+    return (
+      <Section sectionKey="certifications">
+        {(list as unknown as Record<string, unknown>[]).map((c, i) => (
+          <View key={i} style={(i > 0 ? staticStyles.entrySpacing : null) as StyleProp<TextStyle>}>
+            <View style={staticStyles.entryHeaderRow}>
+              <Text style={dynamic.entryTitle}>{str(c.certification_name) || 'Certification'}</Text>
+              <Text style={dynamic.entryMeta}>{dateRange(c.start_date, c.end_date)}</Text>
+            </View>
+            {[str(c.issuer), str(c.credential_id)].filter(Boolean).length ? (
+              <Text style={dynamic.entrySubtitle}>
+                {[str(c.issuer), str(c.credential_id)].filter(Boolean).join('  ·  ')}
+              </Text>
+            ) : null}
+          </View>
+        ))}
+      </Section>
+    );
+  }
+
+  function renderSimpleList(
+    sectionKey: string,
+    list: unknown,
+    lineFor: (item: Record<string, unknown>) => { title: string; detail?: unknown },
+  ) {
+    if (!hasContent(list)) return null;
+    return (
+      <Section sectionKey={sectionKey}>
+        {(list as Record<string, unknown>[]).map((item, i) => {
+          const { title, detail } = lineFor(item);
+          if (!str(title)) return null;
+          return (
+            <View key={i} style={(i > 0 ? staticStyles.skillSpacing : null) as StyleProp<TextStyle>}>
+              <Text style={dynamic.entrySubtitle}>{str(title)}</Text>
+              {str(detail) ? <Text style={dynamic.body}>{str(detail)}</Text> : null}
+            </View>
+          );
+        })}
+      </Section>
+    );
+  }
+
+  function renderHobbies() {
+    const items = str(resumeData.hobbies?.items);
+    if (!items) return null;
+    return (
+      <Section sectionKey="hobbies">
+        <Text style={dynamic.body}>{items}</Text>
+      </Section>
+    );
+  }
+
+  const sectionRenderers: Record<string, () => ReactNode> = {
+    summary: renderSummary,
+    experience: () => renderExperienceLike('experience', resumeData.experience),
+    internships: () => renderExperienceLike('internships', resumeData.internships),
+    education: renderEducation,
+    projects: renderProjects,
+    skills: renderSkills,
+    certifications: renderCertifications,
+    languages: () =>
+      renderSimpleList('languages', resumeData.languages, (l) => ({
+        title: [str(l.language), str(l.proficiency)].filter(Boolean).join(' — '),
+      })),
+    awards: () =>
+      renderSimpleList('awards', resumeData.awards, (a) => ({
+        title: [str(a.title), str(a.issuer)].filter(Boolean).join(' — '),
+        detail: a.description,
+      })),
+    achievements: () =>
+      renderSimpleList('achievements', resumeData.achievements, (a) => ({
+        title: str(a.title),
+        detail: a.description,
+      })),
+    volunteering: () =>
+      renderSimpleList('volunteering', resumeData.volunteering, (v) => ({
+        title: [str(v.organization), str(v.role)].filter(Boolean).join(' — '),
+        detail: v.description,
+      })),
+    references: () =>
+      renderSimpleList('references', resumeData.references, (r) => ({
+        title: [str(r.name), str(r.relationship)].filter(Boolean).join(' — '),
+        detail: r.contact,
+      })),
+    hobbies: renderHobbies,
+  };
+
+  return (
+    <View style={dynamic.page}>
+      {renderHeader()}
+      {layout.sectionOrder.map((key) => {
+        const renderer = sectionRenderers[key];
+        if (!renderer) return null;
+        return <View key={key}>{renderer()}</View>;
+      })}
+    </View>
+  );
+}
+
+// Memoised so a parent re-render with unchanged resumeData/templateConfig
+// (e.g. the preview screen re-rendering for an unrelated reason) doesn't
+// re-render the whole resume.
+export default memo(ResumeRenderer);
+
+const staticStyles = StyleSheet.create({
+  section: {
+    width: '100%',
+  },
+  sectionBody: {
+    marginTop: 8,
+  },
+  entrySpacing: {
+    marginTop: 12,
+  },
+  entryHeaderRow: {
+    alignItems: 'baseline',
+    flexDirection: 'row',
+    justifyContent: 'space-between',
+    gap: 8,
+  },
+  skillSpacing: {
+    marginTop: 6,
+  },
+});
diff --git a/src/features/resumes/mapApiResumeToValues.ts b/src/features/resumes/mapApiResumeToValues.ts
new file mode 100644
index 0000000..1a42f05
--- /dev/null
+++ b/src/features/resumes/mapApiResumeToValues.ts
@@ -0,0 +1,224 @@
+// Inverse of mapResumeValuesToApi. Hydrates the builder form state from the
+// resume document returned by GET /api/v1/resumes/{resume_id}.
+//
+// The backend uses camelCase wire names (personalInfo.fullname,
+// workExperience[], education[].school, skills.programmingLanguages, …) which
+// differ from the builder's field keys (personal.fullName, experience[],
+// education[].institution, skills.programming, …).
+//
+// Defensive throughout: every field falls back to '' / [] so a partial or
+// unexpected payload still yields a valid builder state. TS port of POC
+// src/screens/resumeBuilder/mapApiResumeToValues.js.
+
+import { buildInitialResumeValues, type ResumeBuilderValues } from './resumeBuilderConfig';
+
+function str(value: unknown): string {
+  if (typeof value === 'string') return value;
+  return value === null || value === undefined ? '' : String(value);
+}
+
+function arr<T = unknown>(value: unknown): T[] {
+  return Array.isArray(value) ? (value as T[]) : [];
+}
+
+interface EducationApi {
+  school?: unknown;
+  institution?: unknown;
+  degree?: unknown;
+  startDate?: unknown;
+  start_date?: unknown;
+  endDate?: unknown;
+  end_date?: unknown;
+  scoreType?: unknown;
+  score_type?: unknown;
+  scoreValue?: unknown;
+  cgpa?: unknown;
+}
+
+function mapEducation(list: unknown) {
+  return arr<EducationApi>(list).map((e) => ({
+    institution: str(e.school ?? e.institution),
+    degree: str(e.degree),
+    start_date: str(e.startDate ?? e.start_date),
+    end_date: str(e.endDate ?? e.end_date),
+    score_type: str(e.scoreType ?? e.score_type),
+    cgpa: str(e.scoreValue ?? e.cgpa),
+  }));
+}
+
+interface ExperienceApi {
+  company?: unknown;
+  jobTitle?: unknown;
+  job_title?: unknown;
+  location?: unknown;
+  startDate?: unknown;
+  start_date?: unknown;
+  endDate?: unknown;
+  end_date?: unknown;
+  currentlyWorking?: unknown;
+  description?: unknown;
+}
+
+function mapExperience(list: unknown) {
+  return arr<ExperienceApi>(list).map((e) => {
+    const end = str(e.endDate ?? e.end_date);
+    const currentlyWorking = Boolean(e.currentlyWorking) || end.toLowerCase() === 'present';
+    return {
+      company: str(e.company),
+      job_title: str(e.jobTitle ?? e.job_title),
+      location: str(e.location),
+      start_date: str(e.startDate ?? e.start_date),
+      end_date: currentlyWorking ? '' : end,
+      currentlyWorking,
+      description: str(e.description),
+    };
+  });
+}
+
+interface ProjectApi {
+  name?: unknown;
+  project_name?: unknown;
+  technologies?: unknown;
+  startDate?: unknown;
+  start_date?: unknown;
+  endDate?: unknown;
+  end_date?: unknown;
+  link?: unknown;
+  project_link?: unknown;
+  description?: unknown;
+}
+
+function mapProjects(list: unknown) {
+  return arr<ProjectApi>(list).map((p) => ({
+    project_name: str(p.name ?? p.project_name),
+    technologies: str(p.technologies),
+    start_date: str(p.startDate ?? p.start_date),
+    end_date: str(p.endDate ?? p.end_date),
+    project_link: str(p.link ?? p.project_link),
+    description: str(p.description),
+  }));
+}
+
+interface CertificationApi {
+  name?: unknown;
+  certification_name?: unknown;
+  issuer?: unknown;
+  issueDate?: unknown;
+  start_date?: unknown;
+  expiryDate?: unknown;
+  end_date?: unknown;
+  credentialId?: unknown;
+  credential_id?: unknown;
+}
+
+function mapCertifications(list: unknown) {
+  return arr<CertificationApi>(list).map((c) => ({
+    certification_name: str(c.name ?? c.certification_name),
+    issuer: str(c.issuer),
+    start_date: str(c.issueDate ?? c.start_date),
+    end_date: str(c.expiryDate ?? c.end_date),
+    credential_id: str(c.credentialId ?? c.credential_id),
+  }));
+}
+
+// API skills key → builder skills key.
+const SKILL_KEY_MAP: Record<string, string> = {
+  programmingLanguages: 'programming',
+  frameworks: 'frameworks',
+  databases: 'databases',
+  tools: 'tools',
+  cloudPlatforms: 'cloud',
+  softSkills: 'soft',
+};
+
+interface SkillsApi {
+  programmingLanguages?: unknown;
+  frameworks?: unknown;
+  databases?: unknown;
+  tools?: unknown;
+  cloudPlatforms?: unknown;
+  softSkills?: unknown;
+  customSkills?: { name?: unknown; skills?: unknown }[];
+}
+
+function mapSkills(apiSkills: unknown, base: ResumeBuilderValues['skills']): ResumeBuilderValues['skills'] {
+  const skills: ResumeBuilderValues['skills'] = { ...base };
+  if (apiSkills && typeof apiSkills === 'object') {
+    const src = apiSkills as Record<string, unknown>;
+    for (const [apiKey, builderKey] of Object.entries(SKILL_KEY_MAP)) {
+      if (Array.isArray(src[apiKey])) {
+        skills[builderKey] = (src[apiKey] as unknown[]).map(str).filter(Boolean);
+      }
+    }
+    const custom = (src as SkillsApi).customSkills;
+    if (Array.isArray(custom) && custom.length) {
+      skills.custom = custom.map((c) => ({
+        name: str(c?.name),
+        skills: arr<unknown>(c?.skills).map(str).filter(Boolean),
+      }));
+    }
+  }
+  return skills;
+}
+
+function mapHobbies(hobbies: unknown): { items: string } {
+  if (Array.isArray(hobbies)) {
+    return { items: hobbies.map(str).filter(Boolean).join(', ') };
+  }
+  if (hobbies && typeof hobbies === 'object') {
+    return { items: str((hobbies as { items?: unknown }).items) };
+  }
+  return { items: str(hobbies) };
+}
+
+export interface ApiResumeShape {
+  personalInfo?: Record<string, unknown>;
+  education?: unknown;
+  workExperience?: unknown;
+  experience?: unknown;
+  internships?: unknown;
+  projects?: unknown;
+  certifications?: unknown;
+  skills?: unknown;
+  languages?: unknown;
+  awards?: unknown;
+  achievements?: unknown;
+  references?: unknown;
+  volunteering?: unknown;
+  hobbies?: unknown;
+  [extra: string]: unknown;
+}
+
+export function mapApiResumeToValues(resume: ApiResumeShape = {}): ResumeBuilderValues {
+  const base = buildInitialResumeValues();
+  const personalInfo = (resume.personalInfo ?? {}) as Record<string, unknown>;
+
+  return {
+    ...base,
+    personal: {
+      fullName: str(personalInfo.fullname ?? personalInfo.fullName ?? personalInfo.name),
+      email: str(personalInfo.email),
+      phone: str(personalInfo.phone),
+      location: str(personalInfo.location),
+      linkedin: str(personalInfo.linkedin),
+      github: str(personalInfo.github),
+      portfolio: str(personalInfo.portfolio),
+      headline: str(personalInfo.headline),
+      summary: str(personalInfo.summary),
+    },
+    education: mapEducation(resume.education),
+    experience: mapExperience(resume.workExperience ?? resume.experience),
+    internships: mapExperience(resume.internships),
+    projects: mapProjects(resume.projects),
+    certifications: mapCertifications(resume.certifications),
+    skills: mapSkills(resume.skills, base.skills),
+    languages: arr(resume.languages),
+    awards: arr(resume.awards),
+    achievements: arr(resume.achievements),
+    references: arr(resume.references),
+    volunteering: arr(resume.volunteering),
+    hobbies: mapHobbies(resume.hobbies),
+  };
+}
+
+export default mapApiResumeToValues;
diff --git a/src/features/resumes/mapResumeValuesToApi.ts b/src/features/resumes/mapResumeValuesToApi.ts
new file mode 100644
index 0000000..b39b171
--- /dev/null
+++ b/src/features/resumes/mapResumeValuesToApi.ts
@@ -0,0 +1,152 @@
+// Maps the Resume Builder form state into the PATCH /api/v1/resumes/{resume_id}
+// wire body. PATCH is partial: sections with no data are omitted so we never
+// overwrite a stored value with an empty array/object.
+//
+// Documented schema (from backend):
+//   {
+//     personalInfo: { fullname, email, phone, location, ... },
+//     education:    [ { school, degree, startDate, endDate, scoreType, scoreValue } ],
+//     workExperience / projects / certifications / ... (camelCase fields)
+//   }
+//
+// Skills are intentionally NOT sent through this PATCH — backend manages
+// skills as a separate object. TS port of POC mapResumeValuesToApi.js.
+
+import type { ResumeBuilderValues } from './resumeBuilderConfig';
+
+function trimStr(value: unknown): string {
+  return typeof value === 'string' ? value.trim() : value ? String(value) : '';
+}
+
+/** Drops keys whose value is empty so payload only carries filled-in fields. */
+function compact<T extends Record<string, unknown>>(obj: T): Partial<T> {
+  const out: Partial<T> = {};
+  for (const [key, value] of Object.entries(obj)) {
+    if (value === '' || value === null || value === undefined) continue;
+    (out as Record<string, unknown>)[key] = value;
+  }
+  return out;
+}
+
+function mapPersonalInfo(personal: Partial<ResumeBuilderValues['personal']> = {}) {
+  return compact({
+    fullname: trimStr(personal.fullName),
+    email: trimStr(personal.email),
+    phone: trimStr(personal.phone),
+    location: trimStr(personal.location),
+    headline: trimStr(personal.headline),
+    summary: trimStr(personal.summary),
+    linkedin: trimStr(personal.linkedin),
+    github: trimStr(personal.github),
+    portfolio: trimStr(personal.portfolio),
+  });
+}
+
+function mapEducation(list: ResumeBuilderValues['education'] = []) {
+  return list.map((e) =>
+    compact({
+      school: trimStr(e.institution),
+      degree: trimStr(e.degree),
+      startDate: trimStr(e.start_date),
+      endDate: trimStr(e.end_date),
+      scoreType: trimStr(e.score_type),
+      scoreValue: trimStr(e.cgpa),
+    }),
+  );
+}
+
+function mapExperience(list: ResumeBuilderValues['experience'] = []) {
+  return list.map((e) =>
+    compact({
+      company: trimStr(e.company),
+      jobTitle: trimStr(e.job_title),
+      location: trimStr(e.location),
+      startDate: trimStr(e.start_date),
+      endDate: e.currentlyWorking ? 'Present' : trimStr(e.end_date),
+      currentlyWorking: Boolean(e.currentlyWorking),
+      description: trimStr(e.description),
+    }),
+  );
+}
+
+function mapProjects(list: ResumeBuilderValues['projects'] = []) {
+  return list.map((p) =>
+    compact({
+      name: trimStr(p.project_name),
+      technologies: trimStr(p.technologies),
+      startDate: trimStr(p.start_date),
+      endDate: trimStr(p.end_date),
+      link: trimStr(p.project_link),
+      description: trimStr(p.description),
+    }),
+  );
+}
+
+function mapCertifications(list: ResumeBuilderValues['certifications'] = []) {
+  return list.map((c) =>
+    compact({
+      name: trimStr(c.certification_name),
+      issuer: trimStr(c.issuer),
+      issueDate: trimStr(c.start_date),
+      expiryDate: trimStr(c.end_date),
+      credentialId: trimStr(c.credential_id),
+    }),
+  );
+}
+
+/** Generic passthrough for optional/extra sections — preserves their keys. */
+function mapGenericList(list: Record<string, unknown>[] = []) {
+  return list.map((entry) => compact({ ...entry }));
+}
+
+export interface ResumeApiPayload {
+  personalInfo?: Record<string, unknown>;
+  education?: Record<string, unknown>[];
+  experience?: Record<string, unknown>[];
+  internships?: Record<string, unknown>[];
+  projects?: Record<string, unknown>[];
+  certifications?: Record<string, unknown>[];
+  languages?: Record<string, unknown>[];
+  awards?: Record<string, unknown>[];
+  achievements?: Record<string, unknown>[];
+  references?: Record<string, unknown>[];
+  volunteering?: Record<string, unknown>[];
+  hobbies?: string;
+  [extra: string]: unknown;
+}
+
+export function mapResumeValuesToApi(values: Partial<ResumeBuilderValues> = {}): ResumeApiPayload {
+  const payload: ResumeApiPayload = {};
+
+  const personalInfo = mapPersonalInfo(values.personal);
+  if (Object.keys(personalInfo).length) payload.personalInfo = personalInfo as Record<string, unknown>;
+
+  const sectionMappers: Record<string, (list: unknown[]) => Record<string, unknown>[]> = {
+    education: (l) => mapEducation(l as ResumeBuilderValues['education']) as Record<string, unknown>[],
+    experience: (l) => mapExperience(l as ResumeBuilderValues['experience']) as Record<string, unknown>[],
+    internships: (l) => mapExperience(l as ResumeBuilderValues['experience']) as Record<string, unknown>[],
+    projects: (l) => mapProjects(l as ResumeBuilderValues['projects']) as Record<string, unknown>[],
+    certifications: (l) => mapCertifications(l as ResumeBuilderValues['certifications']) as Record<string, unknown>[],
+    languages: (l) => mapGenericList(l as Record<string, unknown>[]) as Record<string, unknown>[],
+    awards: (l) => mapGenericList(l as Record<string, unknown>[]) as Record<string, unknown>[],
+    achievements: (l) => mapGenericList(l as Record<string, unknown>[]) as Record<string, unknown>[],
+    references: (l) => mapGenericList(l as Record<string, unknown>[]) as Record<string, unknown>[],
+    volunteering: (l) => mapGenericList(l as Record<string, unknown>[]) as Record<string, unknown>[],
+  };
+
+  for (const [key, mapper] of Object.entries(sectionMappers)) {
+    const list = (values as Record<string, unknown>)[key];
+    if (Array.isArray(list) && list.length) {
+      const mapped = mapper(list).filter((entry) => Object.keys(entry).length);
+      if (mapped.length) payload[key] = mapped;
+    }
+  }
+
+  // Hobbies is a single record ({ items }) rather than a list.
+  const hobbies = trimStr(values.hobbies?.items);
+  if (hobbies) payload.hobbies = hobbies;
+
+  return payload;
+}
+
+export default mapResumeValuesToApi;
