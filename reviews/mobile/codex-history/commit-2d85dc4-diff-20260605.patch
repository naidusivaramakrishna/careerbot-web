index 0000000..67a1111
--- /dev/null
+++ b/src/features/resumes/templatesApi.ts
@@ -0,0 +1,320 @@
+// Resume Builder — template catalogue + apply. TS port of POC src/API/templates/templatesApi.js.
+//
+//   GET  /api/v1/templates/categories          → [ "professional", ... ]
+//   GET  /api/v1/templates?category=...        → [ { id, name, ... } ]
+//   POST /api/v1/templates/{resume_id}/apply   body { template_id }
+//   GET  /api/v1/templates/{template_id}       → template configuration JSON
+//
+// Notable robustness inherited from POC:
+//   - Multi-shape URL fallback (4 candidate URLs, FastAPI trailing-slash aware)
+//   - Two-id model: `id` (MongoDB ObjectID for POST /apply) vs `templateId`
+//     (backend slug for GET /templates/{template_id})
+//   - snake_case + camelCase field-name tolerance
+//   - resolveImageUrl handles absolute, relative, and "starts with /" cases
+//
+// `isPremium` is rendered as a display-only badge. Backend MUST enforce premium
+// gating on POST /apply per ADR-0009 (server-side authz). See A8b in the
+// backend coordination doc.
+//
+// Reviewed disposition: PORT-TS per DEEP_REVIEW_DEV_RESUME_BUILDER_2026-06-05.txt §3.4.
+
+import { useMutation, useQuery } from '@tanstack/react-query';
+
+import { baseUrl, httpClient } from '@/api/client/http';
+import { templateEndpoints } from '@/types/contracts/endpoints';
+import { logger } from '@/utils/logger';
+
+// ── Types ───────────────────────────────────────────────────────────────────
+
+export interface TemplateCard {
+  /** MongoDB ObjectID used by POST /api/v1/templates/{resume_id}/apply */
+  id: string;
+  /** Backend slug used by GET /api/v1/templates/{template_id} (config endpoint) */
+  templateId: string;
+  name: string;
+  category: string;
+  previewImage: string;
+  isPremium: boolean;
+  // Preserve any extra fields the backend includes.
+  [extra: string]: unknown;
+}
+
+export interface TemplateConfig {
+  colors?: Record<string, unknown>;
+  typography?: Record<string, unknown>;
+  layout?: Record<string, unknown>;
+  styling?: Record<string, unknown>;
+  sections?: Record<string, { order?: number; enabled?: boolean; label?: string }> | unknown;
+  [extra: string]: unknown;
+}
+
+// ── getTemplateCategories ───────────────────────────────────────────────────
+
+interface CategoryItem {
+  slug?: string;
+  name?: string;
+}
+
+export async function getTemplateCategories(): Promise<string[]> {
+  try {
+    const { data } = await httpClient.get<unknown>(templateEndpoints.categories);
+    const list = normalizeListPayload(data);
+    return list
+      .map((item) =>
+        typeof item === 'string' ? item : ((item as CategoryItem)?.slug ?? (item as CategoryItem)?.name ?? ''),
+      )
+      .filter(Boolean) as string[];
+  } catch (error) {
+    if (statusOf(error) === 404) return [];
+    const message = error instanceof Error ? error.message : 'getTemplateCategories failed';
+    logger.error('[getTemplateCategories] Failed:', message);
+    throw error;
+  }
+}
+
+export function useTemplateCategories() {
+  return useQuery({ queryKey: ['templates', 'categories'], queryFn: getTemplateCategories });
+}
+
+// ── getTemplatesByCategory ──────────────────────────────────────────────────
+
+interface TemplateListEnvelope {
+  templates?: unknown[];
+  items?: unknown[];
+  results?: unknown[];
+  data?: unknown[] | { items?: unknown[]; templates?: unknown[] };
+  docs?: unknown[];
+}
+
+/**
+ * Pulls the array of templates out of whatever envelope the backend uses.
+ * Extends the shared list normaliser with the keys a template API commonly
+ * uses ({ templates: [...] }, nested data.items, ...).
+ */
+function normalizeTemplateList(payload: unknown): unknown[] {
+  if (Array.isArray(payload)) return payload;
+  const env = payload as TemplateListEnvelope;
+  for (const key of ['templates', 'items', 'results', 'data', 'docs'] as const) {
+    if (Array.isArray(env?.[key])) return env[key] as unknown[];
+  }
+  if (Array.isArray((env?.data as { items?: unknown[] })?.items)) {
+    return (env.data as { items: unknown[] }).items;
+  }
+  if (Array.isArray((env?.data as { templates?: unknown[] })?.templates)) {
+    return (env.data as { templates: unknown[] }).templates;
+  }
+  return [];
+}
+
+async function fetchTemplatesPayload(url: string): Promise<unknown> {
+  try {
+    const { data } = await httpClient.get<unknown>(url);
+    return data;
+  } catch (error) {
+    if (statusOf(error) === 404) return null;
+    throw error;
+  }
+}
+
+/**
+ * Robust to backends that ignore `category` or expose only the full collection:
+ * if the filtered request yields nothing, falls back to the full catalogue and
+ * filters client-side by each item's `category` field. Tries 4 URL shapes.
+ */
+export async function getTemplatesByCategory(category: string): Promise<TemplateCard[]> {
+  try {
+    // Use raw path (no baseUrl prefix since httpClient.get sends just the path).
+    const base = templateEndpoints.list;
+    const query = category ? `?category=${encodeURIComponent(category)}` : '';
+
+    const candidates = [
+      query ? `${base}${query}` : '',
+      query ? `${base}/${query}` : '',
+      base,
+      `${base}/`,
+    ].filter(Boolean);
+
+    let rawList: unknown[] = [];
+    let usedUrl = '';
+    for (const url of candidates) {
+      const payload = await fetchTemplatesPayload(url);
+      const parsed = normalizeTemplateList(payload);
+      if (parsed.length) {
+        rawList = parsed;
+        usedUrl = url;
+        break;
+      }
+    }
+
+    let list = rawList;
+    if (category && rawList.some((t) => (t as { category?: string })?.category)) {
+      list = rawList.filter((t) => {
+        const cat = (t as { category?: string })?.category;
+        return !cat || String(cat).toLowerCase() === String(category).toLowerCase();
+      });
+    }
+
+    const cards = list.map(normalizeTemplateCard).filter((t) => t.id);
+
+    logger.info('[getTemplatesByCategory]', category, '→ url:', usedUrl || '(none)', 'raw:', rawList.length, 'cards:', cards.length);
+
+    if (rawList.length && !cards.length) {
+      logger.warn(
+        '[getTemplatesByCategory] templates returned but no id field recognised. Sample item keys:',
+        Object.keys((rawList[0] as Record<string, unknown>) ?? {}).join(', '),
+      );
+    }
+
+    return cards;
+  } catch (error) {
+    const message = error instanceof Error ? error.message : 'getTemplatesByCategory failed';
+    logger.error('[getTemplatesByCategory] Failed:', message);
+    throw error;
+  }
+}
+
+export function useTemplatesByCategory(category: string) {
+  return useQuery({
+    queryKey: ['templates', 'byCategory', category],
+    queryFn: () => getTemplatesByCategory(category),
+    enabled: Boolean(category),
+  });
+}
+
+// ── applyTemplate ───────────────────────────────────────────────────────────
+
+export interface ApplyTemplateVariables {
+  resumeId: string;
+  templateId: string;
+}
+
+export async function applyTemplate({ resumeId, templateId }: ApplyTemplateVariables): Promise<unknown> {
+  if (!resumeId) throw new Error('resume_id is required to apply a template.');
+  if (!templateId) throw new Error('template_id is required to apply a template.');
+
+  try {
+    const url = `${templateEndpoints.base}${encodeURIComponent(resumeId)}/apply`;
+    const { data } = await httpClient.post<unknown>(url, { template_id: templateId });
+    return data;
+  } catch (error) {
+    const message = error instanceof Error ? error.message : 'applyTemplate failed';
+    logger.error('[applyTemplate] Failed:', message);
+    throw error;
+  }
+}
+
+export function useApplyTemplate() {
+  return useMutation({ mutationFn: applyTemplate });
+}
+
+// ── getTemplateConfig ───────────────────────────────────────────────────────
+
+interface ConfigEnvelope {
+  config?: TemplateConfig;
+  data?: TemplateConfig;
+}
+
+export async function getTemplateConfig(templateId: string): Promise<TemplateConfig> {
+  if (!templateId) throw new Error('template_id is required to load a template config.');
+
+  try {
+    const url = `${templateEndpoints.base}${encodeURIComponent(templateId)}`;
+    const { data } = await httpClient.get<unknown>(url);
+    const env = data as ConfigEnvelope;
+    return env?.config ?? env?.data ?? (data as TemplateConfig);
+  } catch (error) {
+    const message = error instanceof Error ? error.message : 'getTemplateConfig failed';
+    logger.error('[getTemplateConfig] Failed:', message);
+    throw error;
+  }
+}
+
+export function useTemplateConfig(templateId: string) {
+  return useQuery({
+    queryKey: ['templates', 'config', templateId],
+    queryFn: () => getTemplateConfig(templateId),
+    enabled: Boolean(templateId),
+  });
+}
+
+// ── Helpers ─────────────────────────────────────────────────────────────────
+
+function statusOf(error: unknown): number | undefined {
+  return error && typeof error === 'object' && 'response' in error
+    ? (error as { response?: { status?: number } }).response?.status
+    : undefined;
+}
+
+function normalizeListPayload(payload: unknown): unknown[] {
+  if (Array.isArray(payload)) return payload;
+  if (Array.isArray((payload as { items?: unknown[] })?.items)) return (payload as { items: unknown[] }).items;
+  if (Array.isArray((payload as { results?: unknown[] })?.results)) return (payload as { results: unknown[] }).results;
+  if (Array.isArray((payload as { data?: unknown[] })?.data)) return (payload as { data: unknown[] }).data;
+  return [];
+}
+
+/** Resolves a raw image path into a full URL the RN Image component can load. */
+function resolveImageUrl(rawUrl: unknown): string {
+  if (typeof rawUrl !== 'string' || !rawUrl) return '';
+  if (rawUrl.startsWith('http://') || rawUrl.startsWith('https://')) return rawUrl;
+  if (rawUrl.startsWith('/')) return `${baseUrl}${rawUrl}`;
+  return rawUrl;
+}
+
+interface RawTemplate {
+  id?: string;
+  _id?: string;
+  template_id?: string;
+  templateId?: string;
+  slug?: string;
+  code?: string;
+  key?: string;
+  name?: string;
+  title?: string;
+  label?: string;
+  category?: string;
+  category_name?: string;
+  type?: string;
+  previewImage?: string;
+  preview_image?: string;
+  previewUrl?: string;
+  preview_url?: string;
+  thumbnail?: string;
+  thumbnail_url?: string;
+  image?: string;
+  image_url?: string;
+  isPremium?: boolean;
+  is_premium?: boolean;
+  premium?: boolean;
+  [extra: string]: unknown;
+}
+
+function normalizeTemplateCard(item: unknown): TemplateCard {
+  if (!item || typeof item !== 'object') {
+    return {
+      id: '',
+      templateId: '',
+      name: 'Template',
+      category: '',
+      previewImage: '',
+      isPremium: false,
+    };
+  }
+  const t = item as RawTemplate;
+
+  const rawPreviewUrl =
+    t.previewImage ?? t.preview_image ?? t.previewUrl ?? t.preview_url ??
+    t.thumbnail ?? t.thumbnail_url ?? t.image ?? t.image_url ?? '';
+
+  const templateId = t.template_id ?? t.templateId ?? t.slug ?? t.code ?? t.key ?? '';
+
+  return {
+    ...t,
+    id: t.id ?? t._id ?? templateId ?? '',
+    templateId,
+    name: t.name ?? t.title ?? t.label ?? 'Template',
+    category: t.category ?? t.category_name ?? t.type ?? '',
+    previewImage: resolveImageUrl(rawPreviewUrl),
+    isPremium: Boolean(t.isPremium ?? t.is_premium ?? t.premium ?? false),
+  };
+}
