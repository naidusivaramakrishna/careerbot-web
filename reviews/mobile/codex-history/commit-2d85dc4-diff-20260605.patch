+// Resume Builder — draft-resume lifecycle. TS port of POC src/API/resumes/resumesApi.js.
+//
+//   POST  /api/v1/resumes/              create an empty draft → { resume_id }
+//   GET   /api/v1/resumes/              list user's resumes
+//   PATCH /api/v1/resumes/{resume_id}   update resume sections (partial)
+//
+// Uses our production axios httpClient (NOT raw fetch like POC) so:
+//   - Token attach/refresh happens via http.ts interceptor + refreshSession single-flight
+//   - HTTPS-only guard, tenant header, correlation handling all centralized
+//   - Sign-out on hard refresh failure flows through registerSignOutHandler hook
+//
+// Reviewed disposition: PORT-TS per DEEP_REVIEW_DEV_RESUME_BUILDER_2026-06-05.txt §3.3.
+
+import { useMutation, useQuery } from '@tanstack/react-query';
+
+import { httpClient } from '@/api/client/http';
+import { resumeBuilderEndpoints } from '@/types/contracts/endpoints';
+import { logger } from '@/utils/logger';
+
+// ── Type definitions ────────────────────────────────────────────────────────
+
+export interface ResumeSummary {
+  id: string;
+  // backend may include various other fields; preserve them via spread elsewhere
+  [extra: string]: unknown;
+}
+
+/** Partial PATCH payload. See mapResumeValuesToApi for the contract shape. */
+export interface ResumePatchPayload {
+  personalInfo?: Record<string, unknown>;
+  education?: unknown[];
+  experience?: unknown[];
+  internships?: unknown[];
+  projects?: unknown[];
+  certifications?: unknown[];
+  languages?: unknown[];
+  awards?: unknown[];
+  achievements?: unknown[];
+  references?: unknown[];
+  volunteering?: unknown[];
+  hobbies?: string;
+  [extra: string]: unknown;
+}
+
+// ── Helpers ─────────────────────────────────────────────────────────────────
+
+interface BackendResumeEnvelope {
+  resume_id?: string;
+  id?: string;
+  _id?: string;
+  data?: { resume_id?: string; id?: string; _id?: string };
+}
+
+/**
+ * Envelope-tolerant id extraction. Accepts `resume_id`, `id`, `_id`, or a
+ * `{ data: {...} }` wrapper. Ported from POC — handles the "what is the id
+ * field this week" class of bugs across backend revisions.
+ */
+function extractResumeId(data: unknown): string {
+  if (!data || typeof data !== 'object') return '';
+  const env = data as BackendResumeEnvelope;
+  return env.resume_id ?? env.id ?? env._id ?? env.data?.resume_id ?? env.data?.id ?? env.data?._id ?? '';
+}
+
+// ── createResume ────────────────────────────────────────────────────────────
+
+/**
+ * POST /api/v1/resumes/ — create an empty draft. Returns the new resume_id.
+ * Throws if the response doesn't include one. No request body required.
+ */
+export async function createResume(): Promise<string> {
+  try {
+    const { data } = await httpClient.post<unknown>(resumeBuilderEndpoints.create, {});
+    const resumeId = extractResumeId(data);
+    if (!resumeId) {
+      throw new Error('Resume created but no resume_id was returned.');
+    }
+    return resumeId;
+  } catch (error) {
+    const message = error instanceof Error ? error.message : 'createResume failed';
+    logger.error('[createResume] Failed:', message);
+    throw error;
+  }
+}
+
+export function useCreateResume() {
+  return useMutation({ mutationFn: createResume });
+}
+
+// ── listResumes ─────────────────────────────────────────────────────────────
+
+interface ListResumesEnvelope {
+  items?: unknown[];
+  results?: unknown[];
+  resumes?: unknown[];
+  data?: unknown[];
+}
+
+/**
+ * GET /api/v1/resumes/ — user's resumes. Returns [] on 404. Accepts a bare
+ * array OR `.items` / `.results` / `.resumes` / `.data` wrappers.
+ * Each returned item has its id extracted into a normalised `id` field.
+ */
+export async function listResumes(): Promise<ResumeSummary[]> {
+  try {
+    const { data } = await httpClient.get<unknown>(resumeBuilderEndpoints.create);
+
+    const rawList: unknown[] = Array.isArray(data)
+      ? data
+      : (data as ListResumesEnvelope)?.items ??
+        (data as ListResumesEnvelope)?.results ??
+        (data as ListResumesEnvelope)?.resumes ??
+        (data as ListResumesEnvelope)?.data ??
+        [];
+
+    return rawList
+      .map((item) => {
+        const id = extractResumeId(item);
+        return { ...(item as Record<string, unknown>), id } as ResumeSummary;
+      })
+      .filter((item) => item.id);
+  } catch (error) {
+    // axios surfaces 404 as a rejection — treat as empty list (POC convention).
+    if (error && typeof error === 'object' && 'response' in error) {
+      const status = (error as { response?: { status?: number } }).response?.status;
+      if (status === 404) return [];
+    }
+    const message = error instanceof Error ? error.message : 'listResumes failed';
+    logger.error('[listResumes] Failed:', message);
+    throw error;
+  }
+}
+
+export function useListResumes() {
+  return useQuery({ queryKey: ['resumes', 'list'], queryFn: listResumes });
+}
+
+// ── getExistingResumeId ─────────────────────────────────────────────────────
+
+/**
+ * Recover the user's existing resume id. The backend enforces "one resume per
+ * user", so after a reinstall / fresh login a POST would 400 with "already
+ * exists". This reuses the existing resume instead. Best-effort: returns '' on
+ * any failure so callers can fall back to createResume() without a hard error.
+ */
+export async function getExistingResumeId(): Promise<string> {
+  try {
+    const resumes = await listResumes();
+    return resumes[0]?.id ?? '';
+  } catch (error) {
+    const message = error instanceof Error ? error.message : 'getExistingResumeId failed';
+    logger.warn('[getExistingResumeId] Failed (non-fatal):', message);
+    return '';
+  }
+}
+
+// ── updateResume ────────────────────────────────────────────────────────────
+
+export interface UpdateResumeVariables {
+  resumeId: string;
+  payload: ResumePatchPayload;
+}
+
+/**
+ * PATCH /api/v1/resumes/{resume_id} — partial update of resume sections.
+ * `payload` shape comes from mapResumeValuesToApi. Returns the updated resume
+ * document (or `null` if the backend returns no body / 204).
+ */
+export async function updateResume({ resumeId, payload }: UpdateResumeVariables): Promise<unknown> {
+  if (!resumeId) {
+    throw new Error('resume_id is required to update a resume.');
+  }
+  try {
+    const url = `${resumeBuilderEndpoints.base}${encodeURIComponent(resumeId)}`;
+    const { data, status } = await httpClient.patch<unknown>(url, payload ?? {});
+    return status === 204 ? null : data;
+  } catch (error) {
+    const message = error instanceof Error ? error.message : 'updateResume failed';
+    logger.error('[updateResume] Failed:', message);
+    throw error;
+  }
+}
+
+export function useUpdateResume() {
+  return useMutation({ mutationFn: updateResume });
+}
