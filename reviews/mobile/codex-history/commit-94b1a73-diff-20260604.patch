+// MSW (Mock Service Worker) handlers for auth endpoints.
+//
+// Per IMPLEMENTATION_BLUEPRINT_FOR_DEVELOPER.txt Day 6 + mobile-API fallback
+// track in MOBILE_ARCHITECTURE_BLUEPRINT §15.B.
+//
+// Lets mobile UI build against accurate mock responses while the backend
+// completes A3 (Apple Sign In endpoint). Shapes match careerbot-api develop2
+// (verified via BACKEND_REALITY_CHECK_2026-06-04.txt).
+//
+// Used by:
+//   - Jest tests (via jest setup file importing setupServer + listen())
+//   - Optional dev-mode toggle (EXPO_PUBLIC_USE_MOCK_API=true)
+//
+// Every mock handler that emulates a backend feature not yet in develop2
+// is tagged `// mockApi: true` so we can audit which tests need re-running
+// when the real endpoints land.
+
+import { http, HttpResponse } from 'msw';
+
+import { httpClient } from '@/api/client/http';
+
+const baseUrl = httpClient.defaults.baseURL ?? '';
+
+// ── Token-response factory ──────────────────────────────────────────────────
+
+interface MockTokenOpts {
+  username?: string;
+  expiresInSec?: number;
+}
+
+function mockTokenResponse(opts: MockTokenOpts = {}) {
+  return {
+    access_token: `mock-access-${Date.now()}`,
+    refresh_token: `mock-refresh-${Date.now()}`,
+    token_type: 'bearer',
+    expires_in: opts.expiresInSec ?? 3600,
+    username: opts.username ?? 'mock-user',
+  };
+}
+
+// ── Sign-in (OAuth2PasswordRequestForm) ─────────────────────────────────────
+
+const signInHandler = http.post(`${baseUrl}/api/v1/auth/signin`, async ({ request }) => {
+  const text = await request.text();
+  const params = new URLSearchParams(text);
+  const username = params.get('username') ?? '';
+  const password = params.get('password') ?? '';
+
+  if (!username || !password) {
+    return HttpResponse.json(
+      { detail: 'Username and password required' },
+      { status: 422 },
+    );
+  }
+
+  // Canned failure for testing 401 path: special "wrong@example.com" email
+  if (username === 'wrong@example.com') {
+    return HttpResponse.json(
+      { detail: 'Invalid credentials' },
+      { status: 401 },
+    );
+  }
+
+  return HttpResponse.json(mockTokenResponse({ username }));
+});
+
+// ── Sign-up (JSON body) ─────────────────────────────────────────────────────
+
+const signUpHandler = http.post(`${baseUrl}/api/v1/auth/signup`, async ({ request }) => {
+  const body = (await request.json()) as Record<string, string>;
+  if (!body.email || !body.password || !body.username || !body.full_name) {
+    return HttpResponse.json(
+      { detail: 'Missing required fields' },
+      { status: 422 },
+    );
+  }
+
+  if (body.email === 'taken@example.com') {
+    return HttpResponse.json(
+      { detail: 'Email already registered' },
+      { status: 409 },
+    );
+  }
+
+  return HttpResponse.json(mockTokenResponse({ username: body.username }));
+});
+
+// ── Refresh (single-flight target) ──────────────────────────────────────────
+
+const refreshHandler = http.post(`${baseUrl}/api/v1/auth/refresh`, async ({ request }) => {
+  const body = (await request.json()) as { refresh_token?: string };
+  if (!body.refresh_token) {
+    return HttpResponse.json(
+      { detail: 'Refresh token not provided' },
+      { status: 401 },
+    );
+  }
+
+  // Canned: refresh tokens starting with "expired-" are rejected (blacklist behavior).
+  if (body.refresh_token.startsWith('expired-')) {
+    return HttpResponse.json(
+      { detail: 'Refresh token revoked or already used' },
+      { status: 401 },
+    );
+  }
+
+  return HttpResponse.json(mockTokenResponse({ username: 'mock-user' }));
+});
+
+// ── Sign-out ────────────────────────────────────────────────────────────────
+
+const signOutHandler = http.post(
+  `${baseUrl}/api/v1/auth/signout`,
+  () => HttpResponse.json({ message: 'Logged out' }),
+);
+
+// ── Password reset (request POST + confirm PATCH) ───────────────────────────
+
+const requestPasswordResetHandler = http.post(
+  `${baseUrl}/api/v1/auth/password/reset`,
+  async () =>
+    HttpResponse.json({
+      success: true,
+      message: 'If this email is registered, you will receive an email shortly',
+    }),
+);
+
+const confirmPasswordResetHandler = http.patch(
+  `${baseUrl}/api/v1/auth/password/reset`,
+  async ({ request }) => {
+    const body = (await request.json()) as { token?: string; new_password?: string };
+    if (!body.token || !body.new_password) {
+      return HttpResponse.json(
+        { detail: 'Token and new_password required' },
+        { status: 422 },
+      );
+    }
+    if (body.token === 'expired-token') {
+      return HttpResponse.json(
+        { detail: 'Reset token expired' },
+        { status: 401 },
+      );
+    }
+    return HttpResponse.json({ message: 'Password reset successfully' });
+  },
+);
+
+// ── Email verification (verify POST + resend POST) ──────────────────────────
+
+const verifyEmailHandler = http.post(
+  `${baseUrl}/api/v1/auth/email/verify`,
+  async ({ request }) => {
+    const body = (await request.json()) as { token?: string };
+    if (!body.token) {
+      return HttpResponse.json({ detail: 'Token required' }, { status: 422 });
+    }
+    if (body.token === 'invalid-verify-token') {
+      return HttpResponse.json({ detail: 'Invalid token' }, { status: 401 });
+    }
+    return HttpResponse.json({ message: 'Email verified successfully' });
+  },
+);
+
+const resendVerificationHandler = http.post(
+  `${baseUrl}/api/v1/auth/email/resend`,
+  async () =>
+    HttpResponse.json({
+      success: true,
+      message: 'If this email is registered, you will receive an email shortly',
+    }),
+);
+
+// ── Profile (GET /auth/profile — used by useUser hook in Phase 3) ───────────
+
+const profileHandler = http.get(`${baseUrl}/api/v1/auth/profile`, ({ request }) => {
+  const auth = request.headers.get('Authorization') ?? '';
+  if (!auth.startsWith('Bearer ')) {
+    return HttpResponse.json({ detail: 'Not authenticated' }, { status: 401 });
+  }
+  return HttpResponse.json({
+    id: 'mock-user-id',
+    username: 'mock-user',
+    email: 'mock@example.com',
+    full_name: 'Mock User',
+    plan: 'free',
+  });
+});
+
+// ── Google OAuth (login-url + callback) ─────────────────────────────────────
+
+const googleLoginUrlHandler = http.get(
+  `${baseUrl}/api/v1/auth/google/login-url`,
+  () =>
+    HttpResponse.json({
+      url: 'https://accounts.google.com/o/oauth2/v2/auth?client_id=mock&redirect_uri=careerbot://auth/google/callback&response_type=code&scope=openid+email+profile&state=mock-state-12345',
+      state: 'mock-state-12345',
+    }),
+);
+
+const googleCallbackHandler = http.post(
+  `${baseUrl}/api/v1/auth/google/callback`,
+  async ({ request }) => {
+    const body = (await request.json()) as { code?: string; state?: string };
+    if (!body.code || !body.state) {
+      return HttpResponse.json(
+        { detail: 'code and state required' },
+        { status: 422 },
+      );
+    }
+    return HttpResponse.json(mockTokenResponse({ username: 'mock-google-user' }));
+  },
+);
+
+// ── LinkedIn OAuth ──────────────────────────────────────────────────────────
+
+const linkedInLoginUrlHandler = http.get(
+  `${baseUrl}/api/v1/auth/linkedin/login-url`,
+  () =>
+    HttpResponse.json({
+      url: 'https://www.linkedin.com/oauth/v2/authorization?client_id=mock&redirect_uri=careerbot://auth/linkedin/callback&response_type=code&scope=r_liteprofile+r_emailaddress&state=mock-li-state-67890',
+      state: 'mock-li-state-67890',
+    }),
+);
+
+const linkedInCallbackHandler = http.post(
+  `${baseUrl}/api/v1/auth/linkedin/callback`,
+  async ({ request }) => {
+    const body = (await request.json()) as { code?: string; state?: string };
+    if (!body.code || !body.state) {
+      return HttpResponse.json(
+        { detail: 'code and state required' },
+        { status: 422 },
+      );
+    }
+    return HttpResponse.json(mockTokenResponse({ username: 'mock-linkedin-user' }));
+  },
+);
+
+// ── Apple OAuth (mockApi: true — backend A3 not yet implemented) ────────────
+//
+// mockApi: true (delete this handler when backend A3 lands)
+
+const appleLoginUrlHandler = http.get(
+  `${baseUrl}/api/v1/auth/apple/login-url`,
+  () =>
+    HttpResponse.json({
+      url: 'https://appleid.apple.com/auth/authorize?client_id=com.careerbot.mobile&redirect_uri=careerbot://auth/apple/callback&response_type=code&scope=name+email&state=mock-apple-state',
+      state: 'mock-apple-state',
+    }),
+);
+
+const appleCallbackHandler = http.post(
+  `${baseUrl}/api/v1/auth/apple/callback`,
+  async ({ request }) => {
+    const body = (await request.json()) as {
+      identityToken?: string;
+      authorizationCode?: string;
+      rawNonce?: string;
+      state?: string;
+      fullName?: { givenName?: string; familyName?: string } | null;
+    };
+    if (!body.identityToken || !body.authorizationCode || !body.rawNonce || !body.state) {
+      return HttpResponse.json(
+        { detail: 'identityToken, authorizationCode, rawNonce, state all required' },
+        { status: 422 },
+      );
+    }
+    return HttpResponse.json(
+      mockTokenResponse({ username: body.fullName?.givenName ?? 'mock-apple-user' }),
+    );
+  },
+);
+
+// ── Exported handler array ──────────────────────────────────────────────────
+
+export const authHandlers = [
+  signInHandler,
+  signUpHandler,
+  refreshHandler,
+  signOutHandler,
+  requestPasswordResetHandler,
+  confirmPasswordResetHandler,
+  verifyEmailHandler,
+  resendVerificationHandler,
+  profileHandler,
+  googleLoginUrlHandler,
+  googleCallbackHandler,
+  linkedInLoginUrlHandler,
+  linkedInCallbackHandler,
+  appleLoginUrlHandler,         // mockApi: true
+  appleCallbackHandler,         // mockApi: true
+];
