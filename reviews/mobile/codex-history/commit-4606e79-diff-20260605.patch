diff --git a/src/components/resume/__tests__/ResumeRenderer.test.tsx b/src/components/resume/__tests__/ResumeRenderer.test.tsx
new file mode 100644
index 0000000..f7ac51c
--- /dev/null
+++ b/src/components/resume/__tests__/ResumeRenderer.test.tsx
@@ -0,0 +1,98 @@
+// Regression test for the entryList guard in ResumeRenderer.
+//
+// Codex r1 P1: replaced `hasContent()` (which let through any non-empty
+// object) with `entryList()` which only accepts an array of plain objects.
+// The renderer's list paths always call `.map()` on the result — letting
+// through `{ items: [] }` would have crashed.
+
+import { render } from '@testing-library/react-native';
+
+import ResumeRenderer from '../ResumeRenderer';
+
+describe('ResumeRenderer — entryList guard', () => {
+  it('does not crash when a list section is given a non-array object envelope', () => {
+    // The defensive contract is: anything that isn't a proper array of
+    // objects renders nothing for that section. Without entryList(), the
+    // hasContent() check would return true for `{ items: [] }`, then the
+    // subsequent `.map()` would throw "list.map is not a function".
+    expect(() =>
+      render(
+        <ResumeRenderer
+          resumeData={
+            {
+              personal: { fullName: 'Test User' },
+              // INTENTIONALLY malformed: an object envelope instead of an
+              // array. The renderer must treat this as "empty".
+              education: { items: [] } as never,
+              experience: { items: [{ company: 'Wrong shape' }] } as never,
+              projects: null as never,
+              certifications: undefined as never,
+              languages: { proficiency: 'fluent' } as never,
+            } as never
+          }
+        />,
+      ),
+    ).not.toThrow();
+  });
+
+  it('renders normally when given the canonical array shape', () => {
+    const { toJSON } = render(
+      <ResumeRenderer
+        resumeData={{
+          personal: {
+            fullName: 'Jane Doe',
+            email: 'jane@example.com',
+            phone: '',
+            location: '',
+            linkedin: '',
+            github: '',
+            portfolio: '',
+            headline: 'Frontend Developer',
+            summary: 'Senior FE engineer.',
+          },
+          education: [
+            {
+              institution: 'MIT',
+              degree: 'BSc',
+              start_date: '2018',
+              end_date: '2022',
+              score_type: 'gpa',
+              cgpa: '3.9',
+            },
+          ],
+          experience: [],
+          internships: [],
+          projects: [],
+          certifications: [],
+          skills: { custom: [], programming: [], frameworks: [], databases: [], tools: [], cloud: [], soft: [] },
+        }}
+      />,
+    );
+
+    const tree = JSON.stringify(toJSON());
+    expect(tree).toContain('Jane Doe');
+    expect(tree).toContain('MIT');
+    expect(tree).toContain('Frontend Developer');
+  });
+
+  it('filters out non-object entries (null, primitive) from an otherwise-valid array', () => {
+    // entryList() must drop nulls/primitives so the .map() never sees them.
+    expect(() =>
+      render(
+        <ResumeRenderer
+          resumeData={
+            {
+              personal: { fullName: 'Test' },
+              education: [
+                { institution: 'Valid', degree: 'BSc', start_date: '', end_date: '', score_type: '', cgpa: '' },
+                null,
+                'string-value',
+                42,
+              ] as never,
+            } as never
+          }
+        />,
+      ),
+    ).not.toThrow();
+  });
+});
diff --git a/src/features/resumes/__tests__/templatesApi.test.ts b/src/features/resumes/__tests__/templatesApi.test.ts
