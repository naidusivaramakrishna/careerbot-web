+// Smoke + props-pass-through test for the ported BuilderPreview.
+
+import { fireEvent, render } from '@testing-library/react-native';
+
+import BuilderPreview from '../BuilderPreview';
+
+describe('BuilderPreview', () => {
+  it('renders the resume name + headline through ResumeRenderer', () => {
+    const { toJSON } = render(
+      <BuilderPreview
+        resumeData={{
+          personal: {
+            fullName: 'Jane Doe',
+            email: '',
+            phone: '',
+            location: '',
+            linkedin: '',
+            github: '',
+            portfolio: '',
+            headline: 'Frontend Developer',
+            summary: '',
+          },
+          education: [],
+          experience: [],
+          internships: [],
+          projects: [],
+          certifications: [],
+          skills: {
+            custom: [],
+            programming: [],
+            frameworks: [],
+            databases: [],
+            tools: [],
+            cloud: [],
+            soft: [],
+          },
+        }}
+        templateConfig={{}}
+        templateId="default"
+        templateName="Modern"
+      />,
+    );
+
+    const tree = JSON.stringify(toJSON());
+    expect(tree).toContain('Jane Doe');
+    expect(tree).toContain('Frontend Developer');
+    // Header shows "Resume Preview" + the template name bar.
+    expect(tree).toContain('Resume Preview');
+    // JSX `Template: {templateName}` renders as two adjacent text children
+    // (`"Template: "` + `"Modern"`) rather than a single concatenated string,
+    // so the serialized tree contains both pieces but not the joined form.
+    expect(tree).toContain('Template: ');
+    expect(tree).toContain('Modern');
+  });
+
+  it('omits the template bar when templateName is empty', () => {
+    const { toJSON } = render(<BuilderPreview resumeData={{}} templateConfig={{}} />);
+    // The literal "Template: " prefix only renders inside the template bar.
+    expect(JSON.stringify(toJSON())).not.toContain('Template: ');
+  });
+
+  it('wires onBack to the header back arrow', () => {
+    const onBack = jest.fn();
+    const { getByLabelText } = render(<BuilderPreview resumeData={{}} onBack={onBack} />);
+    fireEvent.press(getByLabelText('Go back'));
+    expect(onBack).toHaveBeenCalledTimes(1);
+  });
+
+  it('wires onChangeTemplate to the footer secondary button', () => {
+    const onChangeTemplate = jest.fn();
+    const { getByText } = render(<BuilderPreview resumeData={{}} onChangeTemplate={onChangeTemplate} />);
+    fireEvent.press(getByText('Change Template'));
+    expect(onChangeTemplate).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/src/features/resumes/components/__tests__/TemplateSelection.test.tsx b/src/features/resumes/components/__tests__/TemplateSelection.test.tsx
new file mode 100644
index 0000000..64c64d5
--- /dev/null
+++ b/src/features/resumes/components/__tests__/TemplateSelection.test.tsx
@@ -0,0 +1,167 @@
+// Smoke + apply-flow test for the ported TemplateSelection component.
+//
+// Stubs the TanStack Query hooks + the raw apply/getConfig calls so the test
+// runs without a QueryClientProvider (the component itself only consumes the
+// hook return shapes, not the underlying client).
+
+import { fireEvent, render } from '@testing-library/react-native';
+
+import * as templatesApi from '../../templatesApi';
+import TemplateSelection from '../TemplateSelection';
+
+jest.mock('../../templatesApi', () => {
+  const actual = jest.requireActual('../../templatesApi');
+  return {
+    ...actual,
+    useTemplateCategories: jest.fn(),
+    useTemplatesByCategory: jest.fn(),
+    applyTemplate: jest.fn(),
+    getTemplateConfig: jest.fn(),
+  };
+});
+
+const mockUseTemplateCategories = templatesApi.useTemplateCategories as jest.MockedFunction<
+  typeof templatesApi.useTemplateCategories
+>;
+const mockUseTemplatesByCategory = templatesApi.useTemplatesByCategory as jest.MockedFunction<
+  typeof templatesApi.useTemplatesByCategory
+>;
+const mockApplyTemplate = templatesApi.applyTemplate as jest.MockedFunction<typeof templatesApi.applyTemplate>;
+const mockGetTemplateConfig = templatesApi.getTemplateConfig as jest.MockedFunction<
+  typeof templatesApi.getTemplateConfig
+>;
+
+function makeQueryReturn<T>(overrides: Partial<{ data: T; isLoading: boolean; isError: boolean; error: unknown }> = {}) {
+  return {
+    data: undefined,
+    isLoading: false,
+    isError: false,
+    error: null,
+    ...overrides,
+  } as never;
+}
+
+describe('TemplateSelection', () => {
+  beforeEach(() => {
+    jest.clearAllMocks();
+  });
+
+  it('shows the loading spinner while categories are loading', () => {
+    mockUseTemplateCategories.mockReturnValue(makeQueryReturn({ isLoading: true }));
+    mockUseTemplatesByCategory.mockReturnValue(makeQueryReturn());
+
+    const { getByText } = render(<TemplateSelection resumeId="r1" />);
+    expect(getByText('Loading templates…')).toBeTruthy();
+  });
+
+  it('renders the chip row + template grid when both queries resolve', () => {
+    mockUseTemplateCategories.mockReturnValue(makeQueryReturn({ data: ['professional', 'modern'] }));
+    mockUseTemplatesByCategory.mockReturnValue(
+      makeQueryReturn({
+        data: [
+          {
+            id: 'mongo-1',
+            templateId: 'classic',
+            name: 'Classic',
+            category: 'professional',
+            previewImage: '',
+            isPremium: false,
+          },
+          {
+            id: 'mongo-2',
+            templateId: 'bold',
+            name: 'Bold',
+            category: 'professional',
+            previewImage: '',
+            isPremium: true,
+          },
+        ],
+      }),
+    );
+
+    const { getByText, getAllByText, queryByText } = render(<TemplateSelection resumeId="r1" />);
+
+    // "Professional" appears in BOTH the active chip AND each card's category
+    // subtitle (because the seed data has category: 'professional'), so we
+    // assert the count instead of a single match — 1 chip + 2 card subtitles.
+    expect(getAllByText('Professional').length).toBe(3);
+    expect(getByText('Modern')).toBeTruthy(); // chip only — no cards in 'modern' here
+    expect(getByText('Classic')).toBeTruthy();
+    expect(getByText('Bold')).toBeTruthy();
+    expect(getByText('Premium')).toBeTruthy(); // badge on the second card
+    expect(queryByText('No templates in this category yet.')).toBeNull();
+  });
+
+  it('shows the empty state when categories are loaded but templates list is empty', () => {
+    mockUseTemplateCategories.mockReturnValue(makeQueryReturn({ data: ['professional'] }));
+    mockUseTemplatesByCategory.mockReturnValue(makeQueryReturn({ data: [] }));
+
+    const { getByText } = render(<TemplateSelection resumeId="r1" />);
+    expect(getByText('No templates in this category yet.')).toBeTruthy();
+  });
+
+  it('calls applyTemplate + getTemplateConfig + onTemplateApplied with the templateId slug first', async () => {
+    const card = {
+      id: 'mongo-99',
+      templateId: 'sleek-slug',
+      name: 'Sleek',
+      category: 'modern',
+      previewImage: '',
+      isPremium: false,
+    };
+    mockUseTemplateCategories.mockReturnValue(makeQueryReturn({ data: ['modern'] }));
+    mockUseTemplatesByCategory.mockReturnValue(makeQueryReturn({ data: [card] }));
+    mockApplyTemplate.mockResolvedValue({ ok: true });
+    mockGetTemplateConfig.mockResolvedValue({ colors: { primary: '#000' } });
+
+    const onTemplateApplied = jest.fn();
+    const { getByLabelText } = render(
+      <TemplateSelection resumeId="r1" onTemplateApplied={onTemplateApplied} />,
+    );
+
+    fireEvent.press(getByLabelText('Select Sleek template'));
+
+    // Allow the async chain to flush.
+    await Promise.resolve();
+    await Promise.resolve();
+    await Promise.resolve();
+
+    // First-attempt id is the slug (templateId), per the two-id model.
+    expect(mockApplyTemplate).toHaveBeenCalledWith({ resumeId: 'r1', templateId: 'sleek-slug' });
+    expect(mockGetTemplateConfig).toHaveBeenCalledWith('sleek-slug');
+    expect(onTemplateApplied).toHaveBeenCalledTimes(1);
+    expect(onTemplateApplied).toHaveBeenCalledWith({ colors: { primary: '#000' } }, card);
+  });
+
+  it('falls back to the Mongo id if the slug attempt fails', async () => {
+    const card = {
+      id: 'mongo-77',
+      templateId: 'broken-slug',
+      name: 'Fallback',
+      category: 'modern',
+      previewImage: '',
+      isPremium: false,
+    };
+    mockUseTemplateCategories.mockReturnValue(makeQueryReturn({ data: ['modern'] }));
+    mockUseTemplatesByCategory.mockReturnValue(makeQueryReturn({ data: [card] }));
+
+    mockApplyTemplate
+      .mockRejectedValueOnce(new Error('slug not found'))
+      .mockResolvedValueOnce({ ok: true });
+    mockGetTemplateConfig.mockResolvedValueOnce({ id: 'mongo-77' });
+
+    const onTemplateApplied = jest.fn();
+    const { getByLabelText } = render(
+      <TemplateSelection resumeId="r1" onTemplateApplied={onTemplateApplied} />,
+    );
+
+    fireEvent.press(getByLabelText('Select Fallback template'));
+
+    // Flush both rounds of the retry promise chain.
+    for (let i = 0; i < 6; i += 1) await Promise.resolve();
+
+    expect(mockApplyTemplate).toHaveBeenNthCalledWith(1, { resumeId: 'r1', templateId: 'broken-slug' });
+    expect(mockApplyTemplate).toHaveBeenNthCalledWith(2, { resumeId: 'r1', templateId: 'mongo-77' });
+    expect(onTemplateApplied).toHaveBeenCalledTimes(1);
+  });
+});
