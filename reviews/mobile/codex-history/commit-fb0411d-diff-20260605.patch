+import { Ionicons } from '@expo/vector-icons';
+import { Alert, Pressable, ScrollView, StyleSheet, Text, View } from 'react-native';
+
+import ResumeRenderer from '@/components/resume/ResumeRenderer';
+import type { ResumeBuilderValues } from '@/features/resumes/resumeBuilderConfig';
+import type { TemplateConfig } from '@/features/resumes/templatesApi';
+
+export interface BuilderPreviewProps {
+  resumeData?: Partial<ResumeBuilderValues>;
+  /** Backend template configuration JSON (see `useTemplateConfig`). */
+  templateConfig?: TemplateConfig;
+  /**
+   * Stable identity for the active template. Used as the `key` on
+   * ResumeRenderer so it remounts cleanly on template switch (the POC found
+   * this is needed to bust ResumeRenderer's internal useMemo on templateConfig
+   * — a config swap with the same object reference would otherwise stick).
+   */
+  templateId?: string;
+  /** Display-only label rendered in the template bar. */
+  templateName?: string;
+  /** "Back" arrow handler — route shell decides router.back vs navigation.goBack. */
+  onBack?: () => void;
+  /** "Change Template" footer button — route shell pushes the template-selection route. */
+  onChangeTemplate?: () => void;
+}
+
+export default function BuilderPreview({
+  resumeData,
+  templateConfig,
+  templateId,
+  templateName,
+  onBack,
+  onChangeTemplate,
+}: BuilderPreviewProps) {
+  function handleComingSoon(label: string) {
+    Alert.alert(label, `${label} is coming soon.`);
+  }
+
+  // Stable key so the renderer remounts on template switch even when templateConfig
+  // is a different object with the same shape (POC observation — see commit history).
+  const rendererKey =
+    templateId ||
+    (templateConfig as { template_id?: string; id?: string } | undefined)?.template_id ||
+    (templateConfig as { template_id?: string; id?: string } | undefined)?.id ||
+    'default';
+
+  return (
+    <View style={styles.screen}>
+      <View style={styles.header}>
+        <Pressable
+          accessibilityLabel="Go back"
+          accessibilityRole="button"
+          hitSlop={8}
+          onPress={onBack}
+          style={({ pressed }) => [styles.headerIcon, pressed && styles.pressed]}
+        >
+          <Ionicons color="#ffffff" name="arrow-back" size={24} />
+        </Pressable>
+        <Text numberOfLines={1} style={styles.headerTitle}>
+          Resume Preview
+        </Text>
+        <Pressable
+          accessibilityLabel="Download resume"
+          accessibilityRole="button"
+          hitSlop={8}
+          onPress={() => handleComingSoon('Download PDF')}
+          style={({ pressed }) => [styles.headerIcon, pressed && styles.pressed]}
+        >
+          <Ionicons color="#ffffff" name="download-outline" size={22} />
+        </Pressable>
+      </View>
+
+      {templateName ? (
+        <View style={styles.templateBar}>
+          <Ionicons color="#1d4ed8" name="color-palette-outline" size={15} />
+          <Text style={styles.templateBarText} numberOfLines={1}>
+            Template: {templateName}
+          </Text>
+        </View>
+      ) : null}
+
+      <ScrollView contentContainerStyle={styles.stage} showsVerticalScrollIndicator={false}>
+        <View style={styles.paper}>
+          <ResumeRenderer key={rendererKey} resumeData={resumeData} templateConfig={templateConfig as never} />
+        </View>
+      </ScrollView>
+
+      <View style={styles.footer}>
+        <Pressable
+          accessibilityRole="button"
+          onPress={onChangeTemplate}
+          style={({ pressed }) => [styles.secondaryButton, pressed && styles.pressed]}
+        >
+          <Ionicons color="#1d4ed8" name="swap-horizontal-outline" size={18} />
+          <Text style={styles.secondaryButtonText}>Change Template</Text>
+        </Pressable>
+        <Pressable
+          accessibilityRole="button"
+          onPress={() => handleComingSoon('Download PDF')}
+          style={({ pressed }) => [styles.primaryButton, pressed && styles.pressed]}
+        >
+          <Ionicons color="#ffffff" name="download-outline" size={18} />
+          <Text style={styles.primaryButtonText}>Download PDF</Text>
+        </Pressable>
+      </View>
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
