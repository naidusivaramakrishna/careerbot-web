+// Test mock for @expo/vector-icons. The real implementation calls into font
+// loading machinery that crashes under jest-expo's RN test renderer because
+// the font asset isn't registered. Each icon set (Ionicons, FontAwesome, …)
+// is replaced with a Text-rendering stub that preserves the `name` prop so
+// tests can still assert on it via accessibilityLabel / testID.
+
+const React = require('react');
+const { Text } = require('react-native');
+
+function makeIconMock(displayName) {
+  function Icon(props) {
+    const { name, accessibilityLabel, testID, color, size, style } = props;
+    return React.createElement(
+      Text,
+      {
+        accessibilityLabel,
+        testID: testID || `icon-${name}`,
+        // Forward style so size/color assertions still work.
+        style: [{ color, fontSize: size }, style],
+      },
+      // Render the icon name so DOM-style assertions on text content work.
+      name || '',
+    );
+  }
+  Icon.displayName = displayName;
+  return Icon;
+}
+
+module.exports = {
+  Ionicons: makeIconMock('Ionicons'),
+  FontAwesome: makeIconMock('FontAwesome'),
+  FontAwesome5: makeIconMock('FontAwesome5'),
+  MaterialIcons: makeIconMock('MaterialIcons'),
+  MaterialCommunityIcons: makeIconMock('MaterialCommunityIcons'),
+  AntDesign: makeIconMock('AntDesign'),
+  Entypo: makeIconMock('Entypo'),
+  EvilIcons: makeIconMock('EvilIcons'),
+  Feather: makeIconMock('Feather'),
+  Foundation: makeIconMock('Foundation'),
+  Octicons: makeIconMock('Octicons'),
+  SimpleLineIcons: makeIconMock('SimpleLineIcons'),
+  Zocial: makeIconMock('Zocial'),
+  createIconSet: () => makeIconMock('CustomIcon'),
+};
