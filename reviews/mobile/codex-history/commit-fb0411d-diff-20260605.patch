+// Template Selection — opened from the Resume Builder's "Change Template" CTA.
+//
+// Flow (now mediated by TanStack Query hooks rather than POC's useEffect+fetch):
+//   useTemplateCategories()          → user picks a category
+//   useTemplatesByCategory(category) → user picks a template card
+//   applyTemplate({resumeId,...})    → POST /api/v1/templates/{resume_id}/apply
+//   getTemplateConfig(templateId)    → GET /api/v1/templates/{template_id}
+//   onTemplateApplied(config, card)  → hand resolved config back up
+//
+// There is intentionally ONE selection screen for all templates — cards are
+// data, and the chosen template is rendered through ResumeRenderer using its
+// backend configuration. No per-template screens.
+//
+// Notable behaviour preserved from POC:
+//   - Dual-id retry on apply (slug first, then Mongo id) — was a real bug
+//     ("switching does nothing / only some templates work") in the dev's
+//     earlier draft. Same id used for both `apply` AND `getConfig` so they
+//     never disagree.
+//   - `isPremium` badge is display-only; backend MUST enforce premium gating
+//     on POST /apply per A8b (server-side authz).
+//   - Per-card image failure tracking (failedImages set) so a broken thumbnail
+//     falls back to placeholder without crashing the grid.
+//
+// Component is route-agnostic — takes resumeId + onBack + onTemplateApplied
+// as props. Route shell wires it in.
+//
+// TS port of POC src/screens/resumeBuilder/TemplateSelectionScreen.js.
+// useIsMounted + useEffect pattern dropped (TanStack Query handles cleanup).
+
+import { useState } from 'react';
+import { Ionicons } from '@expo/vector-icons';
+import {
+  ActivityIndicator,
+  Image,
+  Pressable,
+  ScrollView,
+  StyleSheet,
+  Text,
+  View,
+} from 'react-native';
+
+import {
+  applyTemplate,
+  getTemplateConfig,
+  useTemplateCategories,
+  useTemplatesByCategory,
+  type TemplateCard,
+  type TemplateConfig,
+} from '@/features/resumes/templatesApi';
+import { logger } from '@/utils/logger';
+
+export interface TemplateSelectionProps {
+  /** The resume the chosen template will be applied to. */
+  resumeId: string;
+  /** Route shell decides router.back vs navigation.goBack. */
+  onBack?: () => void;
+  /** Fired with the resolved template config + the card the user picked. */
+  onTemplateApplied?: (config: TemplateConfig, template: TemplateCard) => void;
+}
+
+function titleCase(value: unknown): string {
+  const text = String(value ?? '');
+  return text ? text.charAt(0).toUpperCase() + text.slice(1) : text;
+}
+
+function errorMessage(error: unknown, fallback: string): string {
+  if (error instanceof Error && error.message) return error.message;
+  if (error && typeof error === 'object' && 'message' in error) {
+    const m = (error as { message?: unknown }).message;
+    if (typeof m === 'string' && m) return m;
+  }
+  return fallback;
+}
+
+export default function TemplateSelection({ resumeId, onBack, onTemplateApplied }: TemplateSelectionProps) {
+  const categoriesQuery = useTemplateCategories();
+  const categories = categoriesQuery.data ?? [];
+
+  // The first category becomes the active one on first successful load.
+  // Local state because the user can switch — derived from `categories` but
+  // never re-derived after the first set so manual switching wins.
+  const [activeCategory, setActiveCategory] = useState<string>('');
+  const effectiveCategory = activeCategory || categories[0] || '';
+
+  const templatesQuery = useTemplatesByCategory(effectiveCategory);
+  const templates = templatesQuery.data ?? [];
+
+  const [applyingId, setApplyingId] = useState<string>('');
+  const [inlineError, setInlineError] = useState<string>('');
+  const [failedImages, setFailedImages] = useState<Set<string>>(new Set());
+
+  async function handleSelectTemplate(template: TemplateCard) {
+    if (applyingId) return;
+    if (!resumeId) {
+      setInlineError('Your resume is still being created. Please try again in a moment.');
+      return;
+    }
+
+    setApplyingId(template.id);
+    setInlineError('');
+    try {
+      // Both /apply (body { template_id }) and GET config key off the same
+      // identifier. The backend may use the slug (template_id) or the Mongo id,
+      // so try the slug first and fall back to the Mongo id — using the SAME id
+      // for apply AND config so they never disagree. Previously apply got the
+      // Mongo id while config got the slug, so apply could throw before the
+      // preview updated → "switching does nothing / only some templates work".
+      const candidateIds = [template.templateId, template.id].filter(
+        (value, index, all) => value && all.indexOf(value) === index,
+      );
+
+      let config: TemplateConfig | null = null;
+      let lastError: unknown = null;
+      for (const id of candidateIds) {
+        try {
+          await applyTemplate({ resumeId, templateId: id });
+          config = await getTemplateConfig(id);
+          lastError = null;
+          break;
+        } catch (attemptError) {
+          lastError = attemptError;
+        }
+      }
+
+      if (lastError || !config) {
+        throw lastError ?? new Error('Unable to load this template.');
+      }
+
+      onTemplateApplied?.(config, template);
+    } catch (error) {
+      logger.warn('[TemplateSelection] apply failed:', errorMessage(error, 'apply failed'));
+      setInlineError(errorMessage(error, 'Unable to apply this template. Please try again.'));
+    } finally {
+      setApplyingId('');
+    }
+  }
+
+  function renderCategoryChips() {
+    return (
+      <ScrollView
+        contentContainerStyle={styles.chipRow}
+        horizontal
+        showsHorizontalScrollIndicator={false}
+        style={styles.chipScroll}
+      >
+        {categories.map((category) => {
+          const isActive = category === effectiveCategory;
+          return (
+            <Pressable
+              accessibilityRole="button"
+              accessibilityState={{ selected: isActive }}
+              disabled={Boolean(applyingId)}
+              key={category}
+              onPress={() => setActiveCategory(category)}
+              style={({ pressed }) => [
+                styles.chip,
+                isActive && styles.chipActive,
+                pressed && styles.pressed,
+              ]}
+            >
+              <Text style={[styles.chipText, isActive && styles.chipTextActive]}>{titleCase(category)}</Text>
+            </Pressable>
+          );
+        })}
+      </ScrollView>
+    );
+  }
+
+  function renderTemplateCard(template: TemplateCard) {
+    const isApplying = applyingId === template.id;
+    return (
+      <Pressable
+        accessibilityLabel={`Select ${template.name} template`}
+        accessibilityRole="button"
+        disabled={Boolean(applyingId)}
+        key={template.id}
+        onPress={() => handleSelectTemplate(template)}
+        style={({ pressed }) => [styles.card, pressed && styles.cardPressed]}
+      >
+        <View style={styles.thumbWrap}>
+          {template.previewImage && !failedImages.has(template.id) ? (
+            <Image
+              resizeMode="cover"
+              source={{ uri: template.previewImage }}
+              style={styles.thumb}
+              onError={() => {
+                setFailedImages((prev) => new Set([...prev, template.id]));
+              }}
+            />
+          ) : (
+            <View style={[styles.thumb, styles.thumbPlaceholder]}>
+              <Ionicons color="#9aa6b5" name="document-text-outline" size={34} />
+            </View>
+          )}
+
+          {template.isPremium ? (
+            <View style={styles.premiumBadge}>
+              <Ionicons color="#7a5b00" name="star" size={11} />
+              <Text style={styles.premiumText}>Premium</Text>
+            </View>
+          ) : null}
+
+          {isApplying ? (
+            <View style={styles.cardOverlay}>
+              <ActivityIndicator color="#ffffff" size="small" />
+            </View>
+          ) : null}
+        </View>
+
+        <Text numberOfLines={1} style={styles.cardName}>
+          {template.name}
+        </Text>
+        <Text numberOfLines={1} style={styles.cardCategory}>
+          {titleCase(template.category || effectiveCategory)}
+        </Text>
+      </Pressable>
+    );
+  }
+
+  function renderBody() {
+    // Initial categories load — block on this; without categories we can't pick.
+    if (categoriesQuery.isLoading) {
+      return (
+        <View style={styles.centerState}>
+          <ActivityIndicator color="#2557A7" size="large" />
+          <Text style={styles.stateText}>Loading templates…</Text>
+        </View>
+      );
+    }
+
+    // Categories failed AND we have no templates to show → full-screen error.
+    if (categoriesQuery.isError && !templates.length) {
+      return (
+        <View style={styles.centerState}>
+          <Ionicons color="#dc2626" name="alert-circle-outline" size={44} />
+          <Text style={styles.errorText}>
+            {errorMessage(categoriesQuery.error, 'Unable to load template categories.')}
+          </Text>
+        </View>
+      );
+    }
+
+    // Templates query own error becomes an inline message above the chips.
+    const templatesError = templatesQuery.isError
+      ? errorMessage(templatesQuery.error, 'Unable to load templates.')
+      : '';
+
+    return (
+      <>
+        {renderCategoryChips()}
+        {inlineError || templatesError ? <Text style={styles.inlineError}>{inlineError || templatesError}</Text> : null}
+        {templatesQuery.isLoading ? (
+          <View style={styles.centerState}>
+            <ActivityIndicator color="#2557A7" size="large" />
+            <Text style={styles.stateText}>Loading templates…</Text>
+          </View>
+        ) : templates.length === 0 ? (
+          <View style={styles.centerState}>
+            <Ionicons color="#9aa6b5" name="albums-outline" size={40} />
+            <Text style={styles.stateText}>No templates in this category yet.</Text>
+          </View>
+        ) : (
+          <ScrollView contentContainerStyle={styles.grid} showsVerticalScrollIndicator={false}>
+            {templates.map(renderTemplateCard)}
+          </ScrollView>
+        )}
+      </>
+    );
+  }
+
+  return (
+    <View style={styles.screen}>
+      <View style={styles.header}>
+        <Pressable
+          accessibilityLabel="Go back"
+          accessibilityRole="button"
+          hitSlop={8}
+          onPress={onBack}
+          style={({ pressed }) => [styles.headerIcon, pressed && styles.pressed]}
+        >
+          <Ionicons color="#ffffff" name="arrow-back" size={24} />
+        </Pressable>
+        <Text numberOfLines={1} style={styles.headerTitle}>
+          Choose a Template
+        </Text>
+        <View style={styles.headerIcon} />
+      </View>
+
+      <Text style={styles.subtitle}>Pick a design — your details stay the same, only the styling changes.</Text>
+
+      {renderBody()}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  screen: {
