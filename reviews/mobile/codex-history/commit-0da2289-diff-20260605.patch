+// ── X-Correlation-Id request interceptor ────────────────────────────────────
+//
+// Injects a unique X-Correlation-Id header on every outbound request so a
+// single user action can be traced across the mobile axios layer → backend
+// logs → CloudWatch/DataDog → support ticket. Carried over from the POC's
+// per-call createCorrelationId() pattern (src/API/profile/_shared.js:40) but
+// promoted to the http layer so EVERY API call gets one, not just profile.
+//
+// Format: `mob-<rfc4122-uuid>` — the `mob-` prefix is a quick visual filter
+// for "request originated from mobile" in shared log views with web traffic.
+//
+// Deliberately non-cryptographic — this is purely a log/debug aid. We use
+// expo-crypto.randomUUID() (which is RFC 4122 v4) only because it's already
+// in deps and slightly nicer than Math.random() collisions on a busy app.
+//
+// Callers that need to continue a distributed trace (e.g. a server-initiated
+// retry) can set `X-Correlation-Id` on their request config; we never
+// overwrite an existing header value.
+
+function generateCorrelationId(): string {
+  try {
+    return `mob-${Crypto.randomUUID()}`;
+  } catch {
+    // expo-crypto.randomUUID() can throw on very old runtimes. Fall back to a
+    // collision-resistant-enough string for log debugging — NOT a UUID, just
+    // tag it as such so we can tell apart cleanly from real UUIDs.
+    const r1 = Math.random().toString(36).slice(2, 10);
+    const r2 = Math.random().toString(36).slice(2, 10);
+    return `mob-fallback-${Date.now()}-${r1}${r2}`;
+  }
+}
+
+httpClient.interceptors.request.use((config) => {
+  // Normalise to an AxiosHeaders instance. By the time a request interceptor
+  // runs, axios v1 has typically already wrapped the headers, but defensively
+  // wrap them ourselves when the test adapter or a caller passes a plain
+  // object — AxiosHeaders.from() accepts both and yields a real
+  // AxiosRequestHeaders, which is what InternalAxiosRequestConfig requires.
+  const headers = AxiosHeaders.from(config.headers as never);
+
+  // Preserve caller-supplied X-Correlation-Id (distributed trace
+  // continuation) — never overwrite it. AxiosHeaders.get is case-insensitive.
+  if (headers.get('X-Correlation-Id')) {
+    config.headers = headers;
+    return config;
+  }
+
+  headers.set('X-Correlation-Id', generateCorrelationId());
+  config.headers = headers;
+  return config;
+});
+
