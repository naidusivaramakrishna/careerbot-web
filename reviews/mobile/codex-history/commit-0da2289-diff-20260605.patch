+// Regression test for the X-Correlation-Id request interceptor in http.ts.
+//
+// Mocks the axios adapter so requests resolve without hitting the network;
+// asserts the interceptor injects a `mob-` prefixed UUID header on each
+// outbound request and preserves any caller-supplied X-Correlation-Id.
+
+// jest-expo's preset mocks expo-crypto.randomUUID() to return a constant
+// (because the real implementation needs the native module wiring). Stub it
+// here to return distinct values per call so the "unique id per request"
+// test actually exercises the interceptor's per-call generation path.
+jest.mock('expo-crypto', () => {
+  let counter = 0;
+  return {
+    randomUUID: jest.fn(() => {
+      counter += 1;
+      return `00000000-0000-4000-8000-${counter.toString(16).padStart(12, '0')}`;
+    }),
+  };
+});
+
+import { httpClient } from '@/api/client/http';
+
+// We mock the axios adapter to capture the final config (after all
+// interceptors) without making a real HTTP call.
+function installCapturingAdapter() {
+  const captured: { headers: Record<string, unknown>[] } = { headers: [] };
+  // axios v1 adapter signature: (config) => Promise<AxiosResponse>
+  httpClient.defaults.adapter = (config) => {
+    // Headers can be an AxiosHeaders instance OR a plain object — flatten both
+    // shapes via toJSON if available.
+    const raw = config.headers;
+    const flat =
+      raw && typeof (raw as { toJSON?: () => Record<string, unknown> }).toJSON === 'function'
+        ? (raw as { toJSON: () => Record<string, unknown> }).toJSON()
+        : { ...(raw as Record<string, unknown>) };
+    captured.headers.push(flat);
+    return Promise.resolve({
+      data: {},
+      status: 200,
+      statusText: 'OK',
+      headers: {},
+      config,
+    } as never);
+  };
+  return captured;
+}
+
+describe('httpClient — X-Correlation-Id request interceptor', () => {
+  it('injects a `mob-` prefixed correlation id on every outbound request', async () => {
+    const captured = installCapturingAdapter();
+
+    await httpClient.get('/api/v1/some-endpoint');
+    await httpClient.post('/api/v1/some-endpoint', { foo: 'bar' });
+
+    expect(captured.headers).toHaveLength(2);
+
+    for (const headers of captured.headers) {
+      const value = (headers['X-Correlation-Id'] ?? headers['x-correlation-id']) as string | undefined;
+      expect(value).toBeDefined();
+      expect(typeof value).toBe('string');
+      // Either `mob-<uuid>` (expo-crypto path) or `mob-fallback-<ts>-<rand>` (fallback path).
+      expect(value).toMatch(/^mob-/);
+    }
+  });
+
+  it('generates a UNIQUE id per request', async () => {
+    const captured = installCapturingAdapter();
+
+    await httpClient.get('/api/v1/req-1');
+    await httpClient.get('/api/v1/req-2');
+    await httpClient.get('/api/v1/req-3');
+
+    const ids = captured.headers.map(
+      (h) => (h['X-Correlation-Id'] ?? h['x-correlation-id']) as string,
+    );
+    expect(ids).toHaveLength(3);
+    expect(new Set(ids).size).toBe(3); // all distinct
+  });
+
+  it('preserves a caller-supplied X-Correlation-Id header (distributed trace continuation)', async () => {
+    const captured = installCapturingAdapter();
+
+    await httpClient.get('/api/v1/traced', {
+      headers: { 'X-Correlation-Id': 'web-existing-trace-id-12345' },
+    });
+
+    const value = (captured.headers[0]['X-Correlation-Id'] ??
+      captured.headers[0]['x-correlation-id']) as string;
+    expect(value).toBe('web-existing-trace-id-12345');
+  });
+
+  it('preserves a caller-supplied lowercase x-correlation-id header', async () => {
+    const captured = installCapturingAdapter();
+
+    await httpClient.get('/api/v1/traced-lower', {
+      headers: { 'x-correlation-id': 'lowercase-id-67890' },
+    });
+
+    // Either case is fine — what matters is that we didn't overwrite the value.
+    const value = (captured.headers[0]['X-Correlation-Id'] ??
+      captured.headers[0]['x-correlation-id']) as string;
+    expect(value).toBe('lowercase-id-67890');
+  });
+});
