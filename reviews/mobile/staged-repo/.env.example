# Public values — safe to commit (this is a SAMPLE)
# Real .env / .env.local are gitignored.

# API base. Leave blank for Expo dev (auto-derives from Metro host on :8000).
# Android emulator → http://10.0.2.2:8000 ; physical device → http://<LAN-IP>:8000.
# Production: https://api.careerbot.com
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_API_PORT=8000
EXPO_PUBLIC_API_TENANT_ID=public
EXPO_PUBLIC_ENV=development

# OAuth public client id (PKCE — NEVER a client secret here).
EXPO_PUBLIC_CLIENT_ID=

# Request timeout (ms)
EXPO_PUBLIC_REQUEST_TIMEOUT=10000

# Dev-only verbose logging
EXPO_PUBLIC_DEBUG_MODE=false

# Sentry (production crash reporting). Public DSN is safe to embed.
EXPO_PUBLIC_SENTRY_DSN=

# PostHog (analytics) — public key only
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
