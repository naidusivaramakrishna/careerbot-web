# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Claude Code internal files
.claude/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/docs/**/*.md
# markdown files (ignore all)
*.md
!README.md
# testing
/coverage
*.tar
*.7z
# next.js
/.next/
/out/
!MSW_INTEGRATION_GUIDE.md
!TESTING_GUIDE.md
# production
/build

# misc
.DS_Store
*.pem

# binary artifacts — never commit archives
*.zip
*.tar.gz
*.gz
*.bin
*.zip
# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
build-output.log
*.log
*.txt


# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / scratch backups
*.backup
